    <!-- YOUTUBE-STYLE STREAMING FEED SECTION -->
    <section id="feedSection" class="space-y-4 pb-8 scroll-mt-24">
      <div class="flex items-center justify-between gap-2 pt-1">
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-zinc-800/90 text-zinc-300">
                      ${category}
                    </span>

                    <button
                      type="button"
                      data-save-id="${escapeHtml(video.id)}"
                      class="save-card-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors ${
                        saved
                          ? 'bg-red-600/20 text-red-400 border border-red-500/40 hover:bg-red-600/30'
                          : 'bg-zinc-800 text-zinc-200 hover:bg-zinc-700 border border-transparent'
                      }"
                      title="${saved ? 'Saved' : 'Save video'}"
                    >
                      <svg class="w-3.5 h-3.5 ${saved ? 'fill-current' : ''}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                      </svg>
                      <span>${saved ? 'Saved' : 'Save'}</span>
                    </button>
                  </div>
                </div>
              </article>
            `;
          })
          .join('');

        // Bind card click & save button click
        els.videoGrid.querySelectorAll('.video-card').forEach((card) => {
          card.addEventListener('click', () => {
            const vidId = card.getAttribute('data-video-id');
            if (vidId) openVideoPlayer(vidId);
          });
        });

        els.videoGrid.querySelectorAll('.save-card-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const vidId = btn.getAttribute('data-save-id');
            if (vidId) toggleSaveVideo(vidId, e);
          });
        });
      }

      // =========================================================================
      // VIDEO PLAYER & TIMED ROTATING BANNER AD
      // =========================================================================
      function renderBannerSlot() {
        const slot = BANNER_SLOTS[state.bannerIndex % BANNER_SLOTS.length];
        els.bannerTag.textContent = slot.tag;
        els.bannerHeadline.textContent = slot.headline;
        els.bannerSubtext.textContent = slot.subtext;
        els.bannerActionBtn.textContent = slot.cta;
      }

      function updateBannerCountdownUI() {
        els.bannerCountdown.textContent = String(state.bannerSecondsLeft);
        const total = Math.max(1, state.bannerActiveInterval || getSlotInterval(state.bannerIndex));
        const pct = Math.max(0, Math.min(100, (state.bannerSecondsLeft / total) * 100));
        els.bannerProgressBar.style.width = `${pct}%`;
      }

      function setBannerSlot(nextIndex) {
        state.bannerIndex = ((nextIndex % BANNER_SLOTS.length) + BANNER_SLOTS.length) % BANNER_SLOTS.length;
        const duration = getSlotInterval(state.bannerIndex);
        state.bannerActiveInterval = duration;
        state.bannerSecondsLeft = duration;
        renderBannerSlot();
        updateBannerCountdownUI();
      }

      function rotateBannerAd(resetTimer = true) {
        setBannerSlot(state.bannerIndex + 1);
        if (resetTimer && state.activeVideoId && state.bannerVisible) {
          startBannerRotation();
        }
      }

      function startBannerRotation() {
        stopBannerRotation();
        if (!state.activeVideoId || !state.bannerVisible) return;

        renderBannerSlot();
        updateBannerCountdownUI();

        bannerTimerId = setInterval(() => {
          if (!state.activeVideoId || !state.bannerVisible) {
            stopBannerRotation();
            return;
          }
          state.bannerSecondsLeft -= 1;
          if (state.bannerSecondsLeft <= 0) {
            setBannerSlot(state.bannerIndex + 1);
          } else {
            updateBannerCountdownUI();
          }
        }, 1000);
      }

      function stopBannerRotation() {
        if (bannerTimerId) {
          clearInterval(bannerTimerId);
          bannerTimerId = null;
        }
      }

      function syncBannerVisibilityUI() {
        if (!state.activeVideoId) {
          els.bannerAdWrapper.classList.add('hidden');
          els.reopenBannerBtn.classList.add('hidden');
          stopBannerRotation();
          return;
        }

        if (state.bannerVisible) {
          els.bannerAdWrapper.classList.remove('hidden');
          els.reopenBannerBtn.classList.add('hidden');
          startBannerRotation();
        } else {
          // Closing banner ad immediately reveals the YouTube-style feed underneath
          els.bannerAdWrapper.classList.add('hidden');
          els.reopenBannerBtn.classList.remove('hidden');
          stopBannerRotation();
        }
      }

      function syncPlayerSaveButton() {
        if (!state.activeVideoId) return;
        const saved = isSaved(state.activeVideoId);
        els.playerSaveText.textContent = saved ? 'Saved' : 'Save';
        els.playerSaveBtn.className = saved
          ? 'inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-red-600/20 hover:bg-red-600/30 border border-red-500/40 text-red-300 text-xs sm:text-sm font-semibold transition-colors'
          : 'inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#1d1d1d] hover:bg-[#2a2a2a] border border-zinc-700/80 text-white text-xs sm:text-sm font-semibold transition-colors';
      }

      function openVideoPlayer(videoId) {
        const video = state.videos.find((v) => v.id === videoId);
        if (!video) return;

        state.activeVideoId = video.id;
        state.bannerVisible = true;
        state.bannerIndex = 0;
        const firstInterval = getSlotInterval(0);
        state.bannerActiveInterval = firstInterval;
        state.bannerSecondsLeft = firstInterval;

        els.playingTitle.textContent = video.title;
        els.playingCategoryBadge.textContent = video.category;
        els.playingDurationBadge.textContent = video.duration ? `Duration: ${video.duration}` : '';

        // Embed YouTube video cleanly
        const embedUrl = `https://www.youtube.com/embed/${encodeURIComponent(video.youtubeId)}?autoplay=1&rel=0&modestbranding=1`;
        els.ytPlayerFrame.src = embedUrl;

        els.playerSection.classList.remove('hidden');
        syncPlayerSaveButton();
        syncBannerVisibilityUI();
        renderFeed();

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function closeVideoPlayer() {
        state.activeVideoId = null;
        els.ytPlayerFrame.src = '';
        els.playerSection.classList.add('hidden');
        stopBannerRotation();
        renderFeed();
      }

      // =========================================================================
      // ADMIN PANEL ACTIONS (ADD, DELETE, RESET)
      // =========================================================================
      function renderAdminVideoList() {
        if (!isAdminUnlocked()) return;
        els.adminVideoCount.textContent = String(state.videos.length);

        if (state.videos.length === 0) {
          els.adminVideoList.innerHTML = `
            <div class="p-4 text-xs text-zinc-400 text-center">No videos in feed yet.</div>
          `;
          return;
        }

        els.adminVideoList.innerHTML = state.videos
          .map((video) => {
            return `
              <div class="p-3 flex items-center justify-between gap-3 hover:bg-zinc-900/60">
                <div class="min-w-0">
                  <p class="text-xs sm:text-sm font-semibold text-white truncate">${escapeHtml(video.title)}</p>
                  <p class="text-[11px] text-zinc-400">
                    ${escapeHtml(video.category)} • ID: <span class="font-mono text-zinc-300">${escapeHtml(video.youtubeId)}</span>
                  </p>
                </div>
                <button
                  type="button"
                  data-delete-id="${escapeHtml(video.id)}"
                  class="admin-delete-btn shrink-0 px-2.5 py-1.5 rounded-lg bg-red-600/15 hover:bg-red-600 text-red-300 hover:text-white border border-red-500/30 text-xs font-semibold transition-colors"
                >
                  Delete
                </button>
              </div>
            `;
          })
          .join('');

        els.adminVideoList.querySelectorAll('.admin-delete-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-delete-id');
            if (!targetId) return;
            state.videos = state.videos.filter((v) => v.id !== targetId);
            state.savedIds = state.savedIds.filter((id) => id !== targetId);
            safeWriteStorage(STORAGE_KEYS.VIDEOS, state.videos);
            safeWriteStorage(STORAGE_KEYS.SAVED, state.savedIds);
            if (state.activeVideoId === targetId) {
              closeVideoPlayer();
            }
            updateSavedBadge();
            renderFeed();
            renderAdminVideoList();
            showToast('Video removed from feed');
          });
        });
      }

      function handleAddVideoSubmit(e) {
        e.preventDefault();
        if (!isAdminUnlocked()) return;

        els.adminFormError.classList.add('hidden');
        els.adminFormError.textContent = '';

        const title = els.videoTitleInput.value.trim();
        const category = normalizeCategoryName(els.videoCategoryInput.value);
        const rawLinkOrId = els.videoUrlOrIdInput.value.trim();
        const customThumb = els.videoThumbInput.value.trim();
        const duration = els.videoDurationInput.value.trim() || '09:30';

        const ytId = extractYouTubeId(rawLinkOrId);
        if (!title) {
          els.adminFormError.textContent = 'Please enter a video title.';
          els.adminFormError.classList.remove('hidden');
          return;
        }
        if (!ytId) {
          els.adminFormError.textContent = 'Please enter a valid YouTube link or 11-character video ID.';
          els.adminFormError.classList.remove('hidden');
          return;
        }

        const newVideo = {
          id: `vid-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
          title,
          category,
          youtubeId: ytId,
          duration,
          customThumb,
          isCustom: true
        };

        state.videos.unshift(newVideo);
        safeWriteStorage(STORAGE_KEYS.VIDEOS, state.videos);

        els.addVideoForm.reset();
        renderFeed();
        renderAdminVideoList();
        showToast('New video added to feed');
      }

      function handleResetSampleData() {
        if (!isAdminUnlocked()) return;
        state.videos = DEFAULT_VIDEOS.map((item) => ({ ...item }));
        state.savedIds = [];
        safeWriteStorage(STORAGE_KEYS.VIDEOS, state.videos);
        safeWriteStorage(STORAGE_KEYS.SAVED, state.savedIds);
        closeVideoPlayer();
        updateSavedBadge();
        renderFeed();
        renderAdminVideoList();
        showToast('Sample feed restored');
      }

      // =========================================================================
      // EVENT LISTENERS & INITIALIZATION
      // =========================================================================
      function bindEvents() {
        els.brandHomeBtn.addEventListener('click', () => {
          closeVideoPlayer();
          state.activeCategory = 'All';
          state.searchQuery = '';
          els.searchInput.value = '';
          els.clearSearchBtn.classList.add('hidden');
          renderFeed();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Search input
        els.searchInput.addEventListener('input', (e) => {
          state.searchQuery = e.target.value;
          els.clearSearchBtn.classList.toggle('hidden', state.searchQuery.length === 0);
          renderFeed();
        });

        els.clearSearchBtn.addEventListener('click', () => {
          state.searchQuery = '';
          els.searchInput.value = '';
          els.clearSearchBtn.classList.add('hidden');
          renderFeed();
          els.searchInput.focus();
        });

        // Category tabs
        els.categoryTabs.querySelectorAll('.cat-tab').forEach((tab) => {
          tab.addEventListener('click', () => {
            const cat = tab.getAttribute('data-category');
            if (!cat) return;
            state.activeCategory = cat;
            renderFeed();
          });
        });

        els.resetFiltersBtn.addEventListener('click', () => {
          state.activeCategory = 'All';
          state.searchQuery = '';
          els.searchInput.value = '';
          els.clearSearchBtn.classList.add('hidden');
          renderFeed();
        });

        // Player & Banner controls
        els.backToFeedBtn.addEventListener('click', closeVideoPlayer);

        els.playerSaveBtn.addEventListener('click', () => {
          if (state.activeVideoId) {
            toggleSaveVideo(state.activeVideoId);
          }
        });

        els.closeBannerAdBtn.addEventListener('click', () => {
          state.bannerVisible = false;
          syncBannerVisibilityUI();
          showToast('Banner closed — feed visible below');
        });

        els.reopenBannerBtn.addEventListener('click', () => {
          state.bannerVisible = true;
          const slotInterval = getSlotInterval(state.bannerIndex);
          state.bannerActiveInterval = slotInterval;
          state.bannerSecondsLeft = slotInterval;
          syncBannerVisibilityUI();
        });

        els.cycleBannerNowBtn.addEventListener('click', () => {
          rotateBannerAd(true);
        });

        els.bannerActionBtn.addEventListener('click', () => {
          const slot = BANNER_SLOTS[state.bannerIndex % BANNER_SLOTS.length];
          if (slot.action === 'openSaved') {
            state.activeCategory = 'Saved';
          } else if (slot.action === 'openAll') {
            state.activeCategory = 'All';
          }
          state.bannerVisible = false;
          syncBannerVisibilityUI();
          renderFeed();
          els.feedSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        // Profile modal & Admin panel
        els.profileBtn.addEventListener('click', openProfileModal);
        els.closeProfileModalBtn.addEventListener('click', closeProfileModal);
        els.cancelProfileBtn.addEventListener('click', closeProfileModal);
        els.profileModal.addEventListener('click', (e) => {
          if (e.target === els.profileModal) closeProfileModal();
        });
        els.profileForm.addEventListener('submit', handleProfileSave);

        els.adminQuickBtn.addEventListener('click', () => {
          if (!isAdminUnlocked()) return;
          const isHidden = els.adminSection.classList.contains('hidden');
          els.adminSection.classList.toggle('hidden', !isHidden);
          if (!isHidden) {
            renderAdminVideoList();
            els.adminSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        els.closeAdminPanelBtn.addEventListener('click', () => {
          els.adminSection.classList.add('hidden');
        });

        els.addVideoForm.addEventListener('submit', handleAddVideoSubmit);
        els.resetSampleDataBtn.addEventListener('click', handleResetSampleData);

        // Escape key closes profile modal
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !els.profileModal.classList.contains('hidden')) {
            closeProfileModal();
          }
        });
      }

      function init() {
        const storedVideos = safeReadStorage(STORAGE_KEYS.VIDEOS, null);
        if (Array.isArray(storedVideos) && storedVideos.length > 0) {
          state.videos = storedVideos.map((item) => ({
            ...item,
            category: normalizeCategoryName(item.category)
          }));
        } else {
          state.videos = DEFAULT_VIDEOS.map((item) => ({ ...item }));
          safeWriteStorage(STORAGE_KEYS.VIDEOS, state.videos);
        }

        const storedSaved = safeReadStorage(STORAGE_KEYS.SAVED, []);
        state.savedIds = Array.isArray(storedSaved) ? storedSaved : [];

        const storedName = safeReadStorage(STORAGE_KEYS.PROFILE_NAME, '');
        state.profileName = typeof storedName === 'string' ? storedName : '';

        bindEvents();
        renderProfileUI();
        updateSavedBadge();
        renderFeed();

        if (isAdminUnlocked()) {
          renderAdminVideoList();
        }
      }

      document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</body>
</html>
