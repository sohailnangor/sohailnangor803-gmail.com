<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>FilmDrama Box — Stream Films, Drama Series &amp; Stories</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      overflow-x: hidden;
      background-color: #0b0b0e;
      color: #f4f4f5;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    /* Native edge-to-edge 16:9 aspect ratio with zero rounded corners or outer borders */
    .yt-aspect {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: #000000;
      border-radius: 0 !important;
      border: 0 !important;
      margin: 0 !important;
    }
    .yt-aspect > iframe,
    .yt-aspect > img,
    .yt-aspect > .yt-overlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 0 !important;
    }
    /* Smooth 30s ad cycle transition */
    .ad-refresh-flash {
      animation: adSwapFade 0.35s ease-out;
    }
    @keyframes adSwapFade {
      0% { opacity: 0.25; transform: translateY(2px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    /* Safe margin above mobile system back/home navigation bar */
    .bottom-safe-zone {
      bottom: calc(26px + env(safe-area-inset-bottom, 0px));
    }
  </style>
</head>
<body class="bg-[#0b0b0e] text-zinc-100 min-h-screen w-full m-0 p-0">

  <!-- TOP STICKY HEADER (Edge-to-Edge Full Width) -->
  <header id="appHeader" class="sticky top-0 z-40 w-full bg-[#0f0f13]/95 backdrop-blur-md border-b border-zinc-800/90">
    <div class="w-full px-3 h-12 flex items-center justify-between gap-2">
      <!-- Brand Logo -->
      <button id="brandHomeBtn" type="button" class="flex items-center gap-2 text-left focus:outline-none shrink-0">
        <span class="w-7 h-7 rounded-md bg-red-600 flex items-center justify-center shadow-sm">
          <svg class="w-3.5 h-3.5 text-white fill-current ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
        <span class="text-base font-extrabold tracking-tight text-white">
          FilmDrama<span class="text-red-500">Box</span>
        </span>
      </button>

      <!-- Header Right Controls -->
      <div class="flex items-center gap-1.5">
        <button
          id="toggleSearchBtn"
          type="button"
          class="w-8 h-8 rounded-full bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 flex items-center justify-center text-zinc-300"
          aria-label="Search videos and series"
          title="Search"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7" />
            <path stroke-linecap="round" d="M20 20l-3.5-3.5" />
          </svg>
        </button>

        <button
          id="headerAdminBtn"
          type="button"
          class="px-2.5 h-8 rounded-full bg-amber-400 hover:bg-amber-300 text-black text-xs font-extrabold flex items-center gap-1 transition-colors"
          title="Open Sohail Nangoor Admin Studio"
        >
          <span>Admin</span>
        </button>

        <button
          id="headerProfileBtn"
          type="button"
          class="h-8 pl-1.5 pr-2.5 rounded-full bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 flex items-center gap-1.5 text-xs font-semibold text-zinc-200"
          title="Profile and Admin Access"
        >
          <span id="profileInitial" class="w-5 h-5 rounded-full bg-red-600 text-white text-[10px] font-extrabold flex items-center justify-center">
            G
          </span>
          <span id="profileDisplayName" class="max-w-[82px] truncate">Guest</span>
        </button>
      </div>
    </div>

    <!-- Collapsible Search Bar -->
    <div id="searchBarContainer" class="hidden w-full px-3 pb-2.5 pt-1 bg-[#0f0f13] border-t border-zinc-800/80">
      <div class="relative flex items-center w-full">
        <input
          id="searchInput"
          type="text"
          placeholder="Search films, drama episodes, folders..."
          class="w-full h-9 pl-3.5 pr-16 rounded-full bg-zinc-900 border border-zinc-700 focus:border-red-500 text-xs text-white placeholder-zinc-400 focus:outline-none"
        />
        <button
          id="clearSearchBtn"
          type="button"
          class="hidden absolute right-2 px-2 py-0.5 rounded-full bg-zinc-800 text-[11px] font-semibold text-zinc-300 hover:text-white"
        >
          Clear
        </button>
      </div>
    </div>

    <!-- SLOT 1: AD_SLOT_TOP (Slim Persistent Top Banner Strip on Feed Views — 30s Auto-Remove & Reload) -->
    <div id="adSlotTopWrapper" class="w-full bg-[#13131a] border-t border-zinc-800/90">
      <div id="adSlotTopActive" class="w-full h-[42px] px-3 flex items-center justify-between gap-2">
        <!-- AD_NETWORK_SCRIPT_HERE (AD_SLOT_TOP: 320x50 / Slim Top Strip) -->
        <div id="adTopContainer" class="flex-1 min-w-0 flex items-center">
          <a
            id="adTopLink"
            href="https://example.com/top-offer-1"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 min-w-0 flex items-center gap-2 py-1 group"
          >
            <span class="px-1.5 py-0.5 rounded bg-amber-400 text-black text-[9px] font-extrabold uppercase shrink-0">
              Ad
            </span>
            <div class="min-w-0 flex-1">
              <p id="adTopTitle" class="text-xs font-bold text-white truncate group-hover:text-amber-300 transition-colors">
                HD Streaming Pass — Watch Uninterrupted Movies &amp; Originals
              </p>
            </div>
            <span id="adTopCta" class="px-2 py-0.5 rounded bg-zinc-800 text-amber-300 text-[10px] font-bold shrink-0">
              Open
            </span>
          </a>
        </div>

        <div class="flex items-center gap-1.5 shrink-0">
          <span id="adTopTimer" class="text-[10px] font-semibold text-zinc-400 tabular-nums" title="Auto-reloads fresh ad every 30s">30s</span>
          <button
            id="closeAdTopBtn"
            type="button"
            class="w-6 h-6 rounded-full bg-zinc-800/90 hover:bg-zinc-700 text-zinc-300 text-xs font-bold flex items-center justify-center"
            title="Hide top banner for 60 seconds"
            aria-label="Close top banner"
          >
            &times;
          </button>
        </div>
      </div>

      <!-- Cooldown Notice when Top Ad is Closed -->
      <div id="adSlotTopCooldown" class="hidden w-full h-[26px] px-3 flex items-center justify-between text-[10px] text-zinc-500 bg-[#0d0d11]">
        <span>Top ad hidden — reloading in <strong id="adTopCooldownSec" class="text-zinc-300">60s</strong></span>
        <button id="restoreAdTopBtn" type="button" class="text-amber-400 font-semibold hover:underline">Show Now</button>
      </div>
    </div>

    <!-- HORIZONTAL SCROLLABLE PURE ENGLISH CATEGORY TABS -->
    <nav class="w-full px-2 py-2 bg-[#0b0b0e] border-t border-zinc-800/80 flex items-center gap-1.5 overflow-x-auto no-scrollbar">
      <button type="button" data-tab="All" class="nav-tab px-3.5 py-1.5 rounded-full text-xs font-bold whitespace-nowrap bg-white text-black">
        All
      </button>
      <button type="button" data-tab="Film" class="nav-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-zinc-900 text-zinc-300 hover:bg-zinc-800">
        Film
      </button>
      <button type="button" data-tab="Drama" class="nav-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-zinc-900 text-zinc-300 hover:bg-zinc-800">
        Drama
      </button>
      <button type="button" data-tab="Stories" class="nav-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-zinc-900 text-zinc-300 hover:bg-zinc-800">
        Stories
      </button>
      <button type="button" data-tab="Drama Box" class="nav-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-zinc-900 text-zinc-300 hover:bg-zinc-800">
        Drama Box
      </button>
      <button type="button" data-tab="Subscribed" class="nav-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-zinc-900 text-zinc-300 hover:bg-zinc-800 flex items-center gap-1.5">
        <span>Subscribed</span>
        <span id="subscribedCountBadge" class="px-1.5 py-0.2 rounded-full bg-red-600 text-white text-[10px] font-extrabold">0</span>
      </button>
    </nav>
  </header>

  <!-- FULL-BLEED EDGE-TO-EDGE STICKY VIDEO PLAYER (Zero Outer Frame / Zero Cover Box) -->
  <section id="stickyPlayerSection" class="hidden sticky top-[48px] z-30 w-full m-0 p-0 bg-black border-b border-zinc-800">
    <!-- 100% Edge-to-Edge 16:9 Iframe Container -->
    <div id="playerFrameContainer" class="yt-aspect w-full m-0 p-0 rounded-none border-0 bg-black">
      <iframe
        id="ytPlayerIframe"
        src=""
        title="FilmDrama Box Video Player"
        class="w-full h-full border-0 m-0 p-0 rounded-none"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
        allowfullscreen
        webkitallowfullscreen
        mozallowfullscreen
      ></iframe>
    </div>

    <!-- Edge-to-Edge Now Playing Metadata & Action Controls -->
    <div class="w-full px-3 py-2.5 bg-[#101015] border-t border-zinc-800/80">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5 mb-1">
            <span id="playerCategoryBadge" class="px-1.5 py-0.5 rounded bg-red-600/20 text-red-400 text-[10px] font-extrabold uppercase">
              Drama
            </span>
            <button
              id="playerFolderJumpBtn"
              type="button"
              class="text-[11px] font-semibold text-amber-400 hover:underline truncate"
            >
              Series Folder
            </button>
          </div>
          <h1 id="playerVideoTitle" class="text-sm sm:text-base font-bold text-white leading-snug line-clamp-2">
            Video Title
          </h1>
        </div>

        <button
          id="closePlayerBtn"
          type="button"
          class="w-8 h-8 rounded-full bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 flex items-center justify-center text-sm font-bold shrink-0"
          title="Close Player"
          aria-label="Close video player"
        >
          &times;
        </button>
      </div>

      <!-- Action Buttons Row (Subscribe, Fullscreen, Next Episode) -->
      <div class="mt-2.5 flex items-center justify-between gap-2">
        <button
          id="playerSubscribeBtn"
          type="button"
          class="px-3.5 py-1.5 rounded-full bg-amber-400 hover:bg-amber-300 text-black text-xs font-extrabold transition-colors"
        >
          Subscribe
        </button>

        <div class="flex items-center gap-1.5">
          <button
            id="playerFullscreenBtn"
            type="button"
            class="px-3 py-1.5 rounded-full bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-xs font-semibold text-zinc-200 flex items-center gap-1"
            title="Enter Full Screen"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4" />
            </svg>
            <span>Fullscreen</span>
          </button>

          <button
            id="playerNextEpBtn"
            type="button"
            class="px-3 py-1.5 rounded-full bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-xs font-semibold text-zinc-200"
          >
            Next &rarr;
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT AREA (100% Full-Width Edge-to-Edge, Zero Outer Padding or Borders) -->
  <main id="mainContentArea" class="w-full m-0 p-0 pb-28">
    <!-- Active Folder Filter Banner (shown when browsing inside a specific folder) -->
    <div id="activeFolderHeader" class="hidden w-full px-3 py-3 bg-[#13131a] border-b border-zinc-800">
      <div class="flex items-center justify-between gap-2">
        <div class="min-w-0">
          <button id="backFromFolderBtn" type="button" class="text-xs font-bold text-amber-400 hover:underline mb-1 inline-flex items-center gap-1">
            <span>&larr; Back to All Folders</span>
          </button>
          <h2 id="activeFolderTitle" class="text-base font-extrabold text-white truncate">Folder Name</h2>
          <p id="activeFolderMeta" class="text-xs text-zinc-400">0 Episodes</p>
        </div>
        <button
          id="activeFolderSubBtn"
          type="button"
          class="px-3.5 py-1.5 rounded-full bg-amber-400 text-black text-xs font-extrabold shrink-0"
        >
          Subscribe
        </button>
      </div>
    </div>

    <!-- PRIMARY FEED / FOLDERS / SUBSCRIBED CONTAINER -->
    <div id="feedContainer" class="w-full m-0 p-0"></div>
  </main>

  <!-- SLOT 3: AD_SLOT_BOTTOM_SAFE (Slim Banner Fixed Safely Above Mobile Back/Navigation Bar During Playback) -->
  <div
    id="adSlotBottomSafeWrapper"
    class="hidden fixed left-0 right-0 z-40 bottom-safe-zone px-2 pointer-events-none"
  >
    <div class="w-full max-w-2xl mx-auto pointer-events-auto rounded-xl bg-[#161620]/95 backdrop-blur-md border border-zinc-700/90 shadow-2xl overflow-hidden">
      <div id="adSlotBottomSafeActive" class="w-full h-[46px] px-3 flex items-center justify-between gap-2">
        <!-- AD_NETWORK_SCRIPT_HERE (AD_SLOT_BOTTOM_SAFE: 320x50 Slim Safe-Zone Banner) -->
        <div id="adBottomSafeContainer" class="flex-1 min-w-0 flex items-center">
          <a
            id="adBottomSafeLink"
            href="https://example.com/bottom-offer-1"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 min-w-0 flex items-center gap-2 py-1 group"
          >
            <span class="px-1.5 py-0.5 rounded bg-amber-400 text-black text-[9px] font-extrabold uppercase shrink-0">
              Ad
            </span>
            <div class="min-w-0 flex-1">
              <p id="adBottomSafeTitle" class="text-xs font-bold text-white truncate group-hover:text-amber-300">
                Play Instant Cloud Games While You Watch Top Series
              </p>
            </div>
            <span id="adBottomSafeCta" class="px-2 py-0.5 rounded bg-amber-400 text-black text-[10px] font-extrabold shrink-0">
              Play
            </span>
          </a>
        </div>

        <div class="flex items-center gap-1.5 shrink-0">
          <span id="adBottomSafeTimer" class="text-[10px] font-semibold text-zinc-400 tabular-nums" title="Auto-reloads fresh ad every 30s">30s</span>
          <button
            id="closeAdBottomSafeBtn"
            type="button"
            class="w-6 h-6 rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-bold flex items-center justify-center"
            title="Hide banner for 60 seconds"
            aria-label="Close bottom banner"
          >
            &times;
          </button>
        </div>
      </div>

      <!-- Cooldown Notice when Bottom Safe Ad is Closed -->
      <div id="adSlotBottomSafeCooldown" class="hidden w-full h-[28px] px-3 flex items-center justify-between text-[10px] text-zinc-400 bg-[#0e0e14]">
        <span>Player banner hidden — resuming in <strong id="adBottomSafeCooldownSec" class="text-white">60s</strong></span>
        <button id="restoreAdBottomSafeBtn" type="button" class="text-amber-400 font-semibold hover:underline">Show Now</button>
      </div>
    </div>
  </div>

  <!-- PROFILE & ADMIN UNLOCK MODAL (Sohail Nangoor) -->
  <div id="profileModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 backdrop-blur-sm p-3">
    <div class="w-full max-w-md rounded-xl bg-[#14141a] border border-zinc-800 shadow-2xl overflow-hidden">
      <div class="px-4 py-3.5 border-b border-zinc-800 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-extrabold text-white">Profile &amp; Sohail Nangoor Admin Access</h2>
          <p class="text-[11px] text-zinc-400">Enter passkey <span class="text-amber-400 font-semibold">Sohail Nangoor 786</span> to unlock Studio</p>
        </div>
        <button id="closeProfileModalBtn" type="button" class="w-8 h-8 rounded-full bg-zinc-800 text-zinc-300 flex items-center justify-center font-bold">
          &times;
        </button>
      </div>

      <form id="profileForm" class="p-4 space-y-3.5">
        <div>
          <label for="profileNameInput" class="block text-xs font-semibold text-zinc-300 mb-1">
            Viewer Name or Admin Passkey
          </label>
          <input
            id="profileNameInput"
            type="text"
            placeholder="Sohail Nangoor 786"
            class="w-full h-10 px-3 rounded-lg bg-[#0b0b0e] border border-zinc-700 focus:border-amber-400 text-sm text-white placeholder-zinc-500 focus:outline-none"
            required
          />
          <p class="text-[11px] text-zinc-400 mt-1">
            Accepted keys: <span class="text-zinc-200 font-semibold">Sohail Nangoor 786</span>, <span class="text-zinc-200 font-semibold">Sohail Nangoor</span>, or <span class="text-zinc-200 font-semibold">admin</span>.
          </p>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
          <button
            id="oneTapUnlockBtn"
            type="button"
            class="px-3 py-2 rounded-lg bg-amber-400/15 hover:bg-amber-400/25 border border-amber-400/40 text-amber-300 text-xs font-bold"
          >
            One-Tap Unlock (Sohail Nangoor 786)
          </button>

          <div class="flex items-center gap-2 ml-auto">
            <button id="cancelProfileModalBtn" type="button" class="px-3.5 py-2 rounded-lg bg-zinc-800 text-xs font-semibold text-zinc-200">
              Cancel
            </button>
            <button type="submit" class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-xs font-bold text-white">
              Unlock &amp; Open
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- SOHAIL NANGOOR 3-TAB ADMIN STUDIO MODAL -->
  <div id="adminModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-sm p-2 sm:p-4">
    <div class="w-full max-w-2xl rounded-xl bg-[#131318] border border-zinc-800 shadow-2xl overflow-hidden max-h-[92vh] flex flex-col">
      <!-- Admin Header -->
      <div class="px-4 py-3 bg-[#181820] border-b border-zinc-800 flex items-center justify-between gap-2">
        <div class="flex items-center gap-2 min-w-0">
          <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[10px] font-extrabold uppercase shrink-0">
            Sohail Nangoor
          </span>
          <h2 class="text-sm font-extrabold text-white truncate">Admin Studio — Folders &amp; Videos</h2>
        </div>
        <button id="closeAdminModalBtn" type="button" class="w-8 h-8 rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-300 flex items-center justify-center font-bold shrink-0">
          &times;
        </button>
      </div>

      <!-- 3 Admin Tabs -->
      <div class="grid grid-cols-3 bg-[#0e0e12] border-b border-zinc-800 text-xs font-bold">
        <button type="button" data-admin-tab="folder" class="admin-tab-btn py-2.5 text-center border-b-2 border-amber-400 text-amber-400 bg-zinc-900/60">
          1. New Folder
        </button>
        <button type="button" data-admin-tab="video" class="admin-tab-btn py-2.5 text-center border-b-2 border-transparent text-zinc-400 hover:text-zinc-200">
          2. Add Video
        </button>
        <button type="button" data-admin-tab="manage" class="admin-tab-btn py-2.5 text-center border-b-2 border-transparent text-zinc-400 hover:text-zinc-200">
          3. Manage &amp; Backup
        </button>
      </div>

      <!-- Admin Tab Bodies -->
      <div class="p-4 overflow-y-auto space-y-4 flex-1">
        <!-- TAB 1: NEW FOLDER -->
        <form id="newFolderForm" class="admin-panel-view space-y-3.5">
          <div class="p-3 rounded-lg bg-zinc-900/90 border border-zinc-800 text-xs text-zinc-300">
            Create unlimited <strong class="text-white">Drama Series</strong> or <strong class="text-white">Film Collection</strong> folders. Users can open any folder to watch episodes in order or subscribe for updates.
          </div>

          <div>
            <label class="block text-xs font-semibold text-zinc-300 mb-1">Folder / Series Title (English)</label>
            <input
              id="folderTitleInput"
              type="text"
              placeholder="e.g., Midnight Promises — Season 1"
              class="w-full h-10 px-3 rounded-lg bg-[#0b0b0e] border border-zinc-700 focus:border-amber-400 text-sm text-white placeholder-zinc-500 focus:outline-none"
              required
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-zinc-300 mb-1">Folder Category</label>
              <select
                id="folderCategorySelect"
                class="w-full h-10 px-3 rounded-lg bg-[#0b0b0e] border border-zinc-700 focus:border-amber-400 text-sm text-white focus:outline-none"
              >
                <option value="Drama">Drama Series</option>
                <option value="Film">Film Collection</option>
                <option value="Stories">Stories Playlist</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-zinc-300 mb-1">Cover Thumbnail URL (Optional)</label>
              <input
                id="folderThumbInput"
                type="url"
                placeholder="https://i.ytimg.com/vi/VIDEO_ID/hqdefault.jpg"
                class="w-full h-10 px-3 rounded-lg bg-[#0b0b0e] border border-zinc-700 focus:border-amber-400 text-sm text-white placeholder-zinc-500 focus:outline-none"
              />
            </div>
          </div>

          <button type="submit" class="w-full py-2.5 rounded-lg bg-amber-400 hover:bg-amber-300 text-black text-xs font-extrabold uppercase tracking-wide">
            Create Folder Now
          </button>
        </form>

        <!-- TAB 2: ADD VIDEO -->
        <form id="addVideoForm" class="admin-panel-view hidden space-y-3.5">
          <div class="p-3 rounded-lg bg-zinc-900/90 border border-zinc-800 text-xs text-zinc-300">
            Every added video automatically appears in <strong class="text-white">both the main Home Feed</strong> and <strong class="text-white">inside the selected Folder</strong>.
          </div>

          <div>
