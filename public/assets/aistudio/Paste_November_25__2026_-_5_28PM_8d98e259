                <a href="${c.url}" target="_blank" rel="noopener noreferrer" class="feed-ad-cta px-2.5 py-1 rounded-md bg-amber-400 hover:bg-amber-300 text-black text-[11px] font-extrabold">${c.cta}</a>
              </div>
