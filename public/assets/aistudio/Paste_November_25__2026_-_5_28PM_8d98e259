      // FULL-BLEED YOUTUBE-STYLE VIDEO ITEM (Zero Outer Card / Zero Rounded Cover Box)
      function buildFullBleedVideoHtml(video) {
        const folder = getFolderById(video.folderId);
        const subscribed = folder ? isFolderSubscribed(folder.id) : false;
        const thumbUrl = `https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`;

        return `
          <article class="w-full m-0 p-0 bg-[#0b0b0e] border-b border-zinc-800/80">
            <!-- 100% Edge-to-Edge 16:9 Thumbnail -->
            <div
              data-play-video="${video.id}"
              class="yt-aspect w-full m-0 p-0 rounded-none cursor-pointer group overflow-hidden bg-black"
            >
              <img
                src="${thumbUrl}"
                alt="${video.title}"
                loading="lazy"
                onerror="this.onerror=null;this.src='https://placehold.co/640x360/121218/f4f4f5?text=FilmDrama+Box';"
                class="w-full h-full object-cover rounded-none group-hover:scale-[1.01] transition-transform duration-200"
              />
              <div class="yt-overlay bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-center justify-center">
                <span class="w-12 h-12 rounded-full bg-black/75 border border-white/25 text-white flex items-center justify-center shadow-lg group-hover:bg-red-600 group-hover:border-red-500 transition-colors">
                  <svg class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </div>
              <span class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-black/85 text-white text-[11px] font-bold tabular-nums">
                ${video.duration || 'HD'}
              </span>
            </div>

            <!-- Edge-to-Edge Video Metadata Row -->
            <div class="w-full px-3 py-2.5 flex items-start justify-between gap-2.5">
              <div data-play-video="${video.id}" class="min-w-0 flex-1 cursor-pointer">
                <h3 class="text-sm font-bold text-white leading-snug line-clamp-2 hover:text-amber-300 transition-colors">
                  ${video.title}
                </h3>
                <div class="mt-1 flex flex-wrap items-center gap-1.5 text-[11px] text-zinc-400">
                  <span class="px-1.5 py-0.2 rounded bg-zinc-900 border border-zinc-800 text-zinc-300 font-semibold">
                    ${video.category}
                  </span>
                  ${folder ? `<span class="text-zinc-300 font-medium truncate max-w-[175px]">${folder.title}</span>` : ''}
                  <span>•</span>
                  <span>${video.views || 'Trending'}</span>
                </div>
              </div>

              ${
                folder
                  ? `<button
                      type="button"
                      data-sub-folder="${folder.id}"
                      class="px-3 py-1.5 rounded-full text-xs font-extrabold shrink-0 transition-colors ${
                        subscribed
                          ? 'bg-zinc-800 border border-zinc-700 text-zinc-200'
                          : 'bg-amber-400 hover:bg-amber-300 text-black'
                      }"
                    >
                      ${subscribed ? 'Subscribed' : 'Subscribe'}
                    </button>`
                  : ''
              }
            </div>
          </article>
        `;
      }

      // DRAMA BOX / FOLDERS VIEW
      function buildFoldersViewHtml() {
        const subFolders = state.folders.filter((f) => isFolderSubscribed(f.id));
        const matchingFolders = state.folders.filter((f) => {
          if (!searchQuery) return true;
          return f.title.toLowerCase().includes(searchQuery) || f.category.toLowerCase().includes(searchQuery);
        });

        let html = '';

        // Subscribed Inbox Strip
        html += `
          <div class="w-full px-3 py-3 bg-[#121218] border-b border-zinc-800">
            <div class="flex items-center justify-between mb-2">
              <h2 class="text-xs font-extrabold uppercase tracking-wider text-amber-400">My Subscribed Inbox (${subFolders.length})</h2>
              <span class="text-[11px] text-zinc-400">Tap any series to open episodes</span>
            </div>
            ${
              subFolders.length
                ? `<div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
                    ${subFolders
                      .map((f) => {
                        const count = state.videos.filter((v) => v.folderId === f.id).length;
                        return `
                          <button type="button" data-open-folder="${f.id}" class="px-3 py-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-left shrink-0 max-w-[210px]">
                            <p class="text-xs font-bold text-white truncate">${f.title}</p>
                            <p class="text-[10px] text-amber-400 font-semibold mt-0.5">${count} Episode${count === 1 ? '' : 's'}</p>
                          </button>
                        `;
                      })
                      .join('')}
                  </div>`
                : `<p class="text-xs text-zinc-400">You have not subscribed to any Drama or Film folder yet. Tap Subscribe on any series below.</p>`
            }
          </div>
        `;

        if (!matchingFolders.length) {
          html += `<div class="w-full px-4 py-12 text-center text-sm text-zinc-400">No folders match your search.</div>`;
          return html;
        }

        html += matchingFolders
          .map((folder, index) => {
            const folderVideos = state.videos.filter((v) => v.folderId === folder.id);
            const subscribed = isFolderSubscribed(folder.id);
            const cover =
              folder.thumbnail ||
              (folderVideos[0] ? `https://i.ytimg.com/vi/${folderVideos[0].youtubeId}/hqdefault.jpg` : 'https://placehold.co/640x360/121218/f4f4f5?text=Series+Folder');

            const rowHtml = `
              <div class="w-full m-0 p-0 bg-[#0b0b0e] border-b border-zinc-800/80">
                <div data-open-folder="${folder.id}" class="yt-aspect w-full m-0 p-0 rounded-none cursor-pointer relative overflow-hidden bg-black">
                  <img
                    src="${cover}"
                    alt="${folder.title}"
                    onerror="this.onerror=null;this.src='https://placehold.co/640x360/121218/f4f4f5?text=Series+Folder';"
                    class="w-full h-full object-cover rounded-none"
                  />
                  <div class="yt-overlay bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-3">
                    <div class="flex items-center justify-between gap-2">
                      <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[10px] font-extrabold uppercase">
                        ${folder.category} Folder
                      </span>
                      <span class="px-2 py-0.5 rounded bg-black/85 text-amber-300 text-xs font-extrabold">
                        ${folderVideos.length} Video${folderVideos.length === 1 ? '' : 's'}
                      </span>
                    </div>
                  </div>
                </div>

                <div class="w-full px-3 py-2.5 flex items-center justify-between gap-2.5">
                  <div data-open-folder="${folder.id}" class="min-w-0 flex-1 cursor-pointer">
                    <h3 class="text-sm font-extrabold text-white truncate">${folder.title}</h3>
                    <p class="text-xs text-zinc-400 mt-0.5">Tap to open playlist &amp; watch episodes</p>
                  </div>
                  <button
                    type="button"
                    data-sub-folder="${folder.id}"
                    class="px-3.5 py-1.5 rounded-full text-xs font-extrabold shrink-0 ${
                      subscribed
                        ? 'bg-zinc-800 border border-zinc-700 text-zinc-200'
                        : 'bg-amber-400 hover:bg-amber-300 text-black'
                    }"
                  >
                    ${subscribed ? 'Subscribed' : 'Subscribe'}
                  </button>
                </div>
              </div>
            `;

            if ((index + 1) % 2 === 0) {
              return rowHtml + buildFeedAdHtml(index + 1);
            }
            return rowHtml;
          })
          .join('');

        return html;
      }

      // RENDER MAIN VIEW
      function renderMainView() {
        const container = document.getElementById('feedContainer');
        const folderHeader = document.getElementById('activeFolderHeader');

        // 1. Inside a specific folder
        if (selectedFolderId) {
          const folder = getFolderById(selectedFolderId);
          if (!folder) {
            selectedFolderId = null;
          } else {
            const folderVideos = state.videos.filter((v) => v.folderId === folder.id);
            folderHeader.classList.remove('hidden');
            document.getElementById('activeFolderTitle').textContent = folder.title;
            document.getElementById('activeFolderMeta').textContent = `${folder.category} • ${folderVideos.length} Video${folderVideos.length === 1 ? '' : 's'}`;

            const subBtn = document.getElementById('activeFolderSubBtn');
            const subscribed = isFolderSubscribed(folder.id);
            subBtn.textContent = subscribed ? 'Subscribed ✓' : 'Subscribe';
            subBtn.className = subscribed
              ? 'px-3.5 py-1.5 rounded-full bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold shrink-0'
              : 'px-3.5 py-1.5 rounded-full bg-amber-400 text-black text-xs font-extrabold shrink-0';
            subBtn.onclick = () => toggleFolderSubscription(folder.id);

            if (!folderVideos.length) {
              container.innerHTML = `<div class="w-full px-4 py-12 text-center text-sm text-zinc-400">No episodes uploaded to this folder yet. Add videos from the Sohail Nangoor Admin Panel.</div>`;
              return;
            }

            container.innerHTML = folderVideos
              .map((v, idx) => buildFullBleedVideoHtml(v) + (idx === 0 ? buildFeedAdHtml(1) : ''))
              .join('');
            return;
          }
        }

        folderHeader.classList.add('hidden');

        // 2. Drama Box / Folders Tab
        if (activeTab === 'Drama Box') {
          container.innerHTML = buildFoldersViewHtml();
          return;
        }

        // 3. Subscribed Tab
        if (activeTab === 'Subscribed') {
          const subVideos = state.videos.filter((v) => v.folderId && isFolderSubscribed(v.folderId));
          if (!subVideos.length) {
            container.innerHTML = `
              <div class="w-full px-4 py-14 text-center space-y-3">
                <p class="text-sm font-bold text-white">Your Subscribed Inbox is Empty</p>
                <p class="text-xs text-zinc-400 max-w-xs mx-auto">Subscribe to any Drama Series or Film Folder to track all its latest episodes here.</p>
                <button type="button" id="goToDramaBoxBtn" class="px-4 py-2 rounded-full bg-amber-400 text-black text-xs font-extrabold">
                  Browse Drama Box Folders
                </button>
              </div>
            `;
            const jumpBtn = document.getElementById('goToDramaBoxBtn');
            if (jumpBtn) {
              jumpBtn.onclick = () => {
                activeTab = 'Drama Box';
                updateTabStyles();
                renderMainView();
              };
            }
            return;
          }

          container.innerHTML = subVideos
            .map((v, idx) => buildFullBleedVideoHtml(v) + ((idx + 1) % 2 === 0 ? buildFeedAdHtml(idx + 1) : ''))
            .join('');
          return;
        }

        // 4. Home Feed (All / Film / Drama / Stories)
        const filteredVideos = state.videos.filter((video) => {
          const catMatch = activeTab === 'All' || video.category === activeTab;
          if (!catMatch) return false;
          if (!searchQuery) return true;
          const folder = getFolderById(video.folderId);
          return (
            video.title.toLowerCase().includes(searchQuery) ||
            video.category.toLowerCase().includes(searchQuery) ||
            (folder && folder.title.toLowerCase().includes(searchQuery))
          );
        });

        if (!filteredVideos.length) {
          container.innerHTML = `<div class="w-full px-4 py-12 text-center text-sm text-zinc-400">No videos found matching your selection.</div>`;
          return;
        }

        container.innerHTML = filteredVideos
          .map((video, idx) => {
            const card = buildFullBleedVideoHtml(video);
            if (idx === 0 || (idx + 1) % 2 === 0) {
              return card + buildFeedAdHtml(idx + 1);
            }
            return card;
          })
          .join('');
      }

      function updateTabStyles() {
        document.querySelectorAll('.nav-tab').forEach((btn) => {
          const tabName = btn.getAttribute('data-tab');
          if (tabName === activeTab) {
            btn.className = 'nav-tab px-3.5 py-1.5 rounded-full text-xs font-bold whitespace-nowrap bg-white text-black flex items-center gap-1.5';
          } else {
            btn.className = 'nav-tab px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap bg-zinc-900 text-zinc-300 hover:bg-zinc-800 flex items-center gap-1.5';
          }
        });
      }

      // ADMIN STUDIO RENDERING
      function renderAdminLists() {
        const folderSelect = document.getElementById('videoFolderSelect');
        folderSelect.innerHTML =
          `<option value="">-- No Folder (Home Feed Only) --</option>` +
          state.folders.map((f) => `<option value="${f.id}">${f.title} (${f.category})</option>`).join('');

        const adminFolders = document.getElementById('adminFolderList');
        adminFolders.innerHTML = state.folders.length
          ? state.folders
              .map(
                (f) => `
                <div class="px-3 py-2 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <p class="text-xs font-bold text-white truncate">${f.title}</p>
                    <p class="text-[10px] text-zinc-400">${f.category}</p>
                  </div>
                  <button type="button" data-delete-folder="${f.id}" class="px-2.5 py-1 rounded bg-red-600/20 text-red-400 text-[11px] font-bold shrink-0">
                    Delete
                  </button>
                </div>
              `
              )
              .join('')
          : `<p class="text-xs text-zinc-500">No folders created yet.</p>`;

        const adminVideos = document.getElementById('adminVideoList');
        adminVideos.innerHTML = state.videos.length
          ? state.videos
              .map((v) => {
                const folder = getFolderById(v.folderId);
                return `
                  <div class="px-3 py-2 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-between gap-2">
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-white truncate">${v.title}</p>
                      <p class="text-[10px] text-zinc-400">${v.category}${folder ? ` • ${folder.title}` : ''}</p>
                    </div>
                    <button type="button" data-delete-video="${v.id}" class="px-2.5 py-1 rounded bg-red-600/20 text-red-400 text-[11px] font-bold shrink-0">
                      Delete
                    </button>
                  </div>
                `;
              })
              .join('')
          : `<p class="text-xs text-zinc-500">No videos published yet.</p>`;
      }

      function openAdminStudio() {
        renderAdminLists();
        document.getElementById('adminModal').classList.remove('hidden');
        document.getElementById('adminModal').classList.add('flex');
      }

      function closeAdminStudio() {
        document.getElementById('adminModal').classList.add('hidden');
        document.getElementById('adminModal').classList.remove('flex');
      }

      function openProfileModal() {
        document.getElementById('profileNameInput').value = state.profileName === 'Guest' ? '' : state.profileName;
        document.getElementById('profileModal').classList.remove('hidden');
        document.getElementById('profileModal').classList.add('flex');
      }

      function closeProfileModal() {
        document.getElementById('profileModal').classList.add('hidden');
        document.getElementById('profileModal').classList.remove('flex');
      }

      // EVENT DELEGATION & BINDINGS
      function bindEvents() {
        document.getElementById('brandHomeBtn').addEventListener('click', () => {
          activeTab = 'All';
          selectedFolderId = null;
          searchQuery = '';
          document.getElementById('searchInput').value = '';
          updateTabStyles();
          renderMainView();
        });

        document.getElementById('toggleSearchBtn').addEventListener('click', () => {
          const bar = document.getElementById('searchBarContainer');
          bar.classList.toggle('hidden');
          if (!bar.classList.contains('hidden')) {
            document.getElementById('searchInput').focus();
          }
        });

        document.getElementById('searchInput').addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase();
          document.getElementById('clearSearchBtn').classList.toggle('hidden', !searchQuery);
          renderMainView();
        });

        document.getElementById('clearSearchBtn').addEventListener('click', () => {
          searchQuery = '';
          document.getElementById('searchInput').value = '';
          document.getElementById('clearSearchBtn').classList.add('hidden');
          renderMainView();
        });

        document.querySelectorAll('.nav-tab').forEach((btn) => {
          btn.addEventListener('click', () => {
            activeTab = btn.getAttribute('data-tab');
            selectedFolderId = null;
            updateTabStyles();
            renderMainView();
          });
        });

        document.getElementById('backFromFolderBtn').addEventListener('click', () => {
          selectedFolderId = null;
          renderMainView();
        });

        document.getElementById('closePlayerBtn').addEventListener('click', closePlayer);
        document.getElementById('playerNextEpBtn').addEventListener('click', playNextVideo);
        document.getElementById('playerFullscreenBtn').addEventListener('click', triggerNativeFullscreen);

        // Top Ad Close / Restore
        document.getElementById('closeAdTopBtn').addEventListener('click', () => {
          adState.top.cooldown = 60;
          updateAdSlotDom(null);
        });
        document.getElementById('restoreAdTopBtn').addEventListener('click', () => {
          adState.top.cooldown = 0;
          adState.top.remaining = 30;
          adState.top.index += 1;
          updateAdSlotDom('top');
        });

        // Bottom Safe-Zone Ad Close / Restore
        document.getElementById('closeAdBottomSafeBtn').addEventListener('click', () => {
          adState.bottomSafe.cooldown = 60;
          updateAdSlotDom(null);
        });
        document.getElementById('restoreAdBottomSafeBtn').addEventListener('click', () => {
          adState.bottomSafe.cooldown = 0;
          adState.bottomSafe.remaining = 30;
          adState.bottomSafe.index += 1;
          updateAdSlotDom('bottomSafe');
        });

        // Main Content Delegated Events
        document.getElementById('mainContentArea').addEventListener('click', (e) => {
          const playEl = e.target.closest('[data-play-video]');
          if (playEl) {
            playVideo(playEl.getAttribute('data-play-video'));
            return;
          }

          const folderEl = e.target.closest('[data-open-folder]');
          if (folderEl) {
            selectedFolderId = folderEl.getAttribute('data-open-folder');
            renderMainView();
            return;
          }

          const subEl = e.target.closest('[data-sub-folder]');
          if (subEl) {
            toggleFolderSubscription(subEl.getAttribute('data-sub-folder'));
            return;
          }

          if (e.target.closest('.close-feed-ad-btn')) {
            adState.feed.cooldown = 60;
            updateAdSlotDom(null);
            return;
          }

          if (e.target.closest('.restore-feed-ad-btn')) {
            adState.feed.cooldown = 0;
            adState.feed.remaining = 30;
            adState.feed.index += 1;
            updateAdSlotDom('feed');
          }
        });

        // Header Admin & Profile Buttons
        document.getElementById('headerAdminBtn').addEventListener('click', () => {
          if (isAdminUnlocked()) {
            openAdminStudio();
          } else {
            openProfileModal();
          }
        });

        document.getElementById('headerProfileBtn').addEventListener('click', openProfileModal);
        document.getElementById('closeProfileModalBtn').addEventListener('click', closeProfileModal);
        document.getElementById('cancelProfileModalBtn').addEventListener('click', closeProfileModal);

        document.getElementById('oneTapUnlockBtn').addEventListener('click', () => {
          state.profileName = 'Sohail Nangoor 786';
          saveState();
          renderHeaderProfile();
          closeProfileModal();
          openAdminStudio();
          showToast('Sohail Nangoor Admin Studio Unlocked');
        });

        document.getElementById('profileForm').addEventListener('submit', (e) => {
          e.preventDefault();
          const entered = document.getElementById('profileNameInput').value.trim();
          state.profileName = entered || 'Guest';
          saveState();
          renderHeaderProfile();
          closeProfileModal();

          if (isAdminUnlocked(state.profileName)) {
            openAdminStudio();
            showToast('Welcome Sohail Nangoor — Admin Studio Unlocked');
          } else {
            showToast(`Profile updated to ${state.profileName}`);
          }
        });

        // Admin Modal Close & Tabs
        document.getElementById('closeAdminModalBtn').addEventListener('click', closeAdminStudio);

        document.querySelectorAll('.admin-tab-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-admin-tab');
            document.querySelectorAll('.admin-tab-btn').forEach((b) => {
              const active = b.getAttribute('data-admin-tab') === target;
              b.className = active
                ? 'admin-tab-btn py-2.5 text-center border-b-2 border-amber-400 text-amber-400 bg-zinc-900/60'
                : 'admin-tab-btn py-2.5 text-center border-b-2 border-transparent text-zinc-400 hover:text-zinc-200';
            });

            document.getElementById('newFolderForm').classList.toggle('hidden', target !== 'folder');
            document.getElementById('addVideoForm').classList.toggle('hidden', target !== 'video');
            document.getElementById('manageBackupView').classList.toggle('hidden', target !== 'manage');
            renderAdminLists();
          });
        });

        // Create New Folder
        document.getElementById('newFolderForm').addEventListener('submit', (e) => {
          e.preventDefault();
          const title = document.getElementById('folderTitleInput').value.trim();
          const category = document.getElementById('folderCategorySelect').value;
          const thumbnail = document.getElementById('folderThumbInput').value.trim();
          if (!title) return;

          state.folders.unshift({
            id: 'folder-' + Date.now(),
            title,
            category,
            thumbnail
          });
          saveState();
          document.getElementById('folderTitleInput').value = '';
          document.getElementById('folderThumbInput').value = '';
          renderAdminLists();
          renderMainView();
          showToast(`Folder "${title}" created`);
        });

        // Add Video to Feed & Folder
        document.getElementById('addVideoForm').addEventListener('submit', (e) => {
          e.preventDefault();
          const rawUrl = document.getElementById('videoUrlInput').value;
          const youtubeId = extractYouTubeId(rawUrl);
          if (!youtubeId) {
            showToast('Please enter a valid YouTube URL or 11-character Video ID');
            return;
          }

          const title = document.getElementById('videoTitleInput').value.trim();
          const category = document.getElementById('videoCategorySelect').value;
          const folderId = document.getElementById('videoFolderSelect').value;
          const duration = document.getElementById('videoDurationInput').value.trim() || 'HD';

          state.videos.unshift({
            id: 'vid-' + Date.now(),
            youtubeId,
            title,
            category,
            folderId,
            duration,
            views: 'New Release',
            uploadedAt: 'Just now'
          });

          saveState();
          document.getElementById('videoUrlInput').value = '';
          document.getElementById('videoTitleInput').value = '';
          renderAdminLists();
          renderMainView();
          showToast('Video published to Home Feed & Folder');
        });

        // Manage & Backup Actions
        document.getElementById('manageBackupView').addEventListener('click', (e) => {
          const delFolderBtn = e.target.closest('[data-delete-folder]');
          if (delFolderBtn) {
            const fid = delFolderBtn.getAttribute('data-delete-folder');
            state.folders = state.folders.filter((f) => f.id !== fid);
            state.subscribedFolderIds = state.subscribedFolderIds.filter((id) => id !== fid);
            saveState();
            updateSubscribedBadge();
            renderAdminLists();
            renderMainView();
            showToast('Folder removed');
            return;
          }

          const delVideoBtn = e.target.closest('[data-delete-video]');
          if (delVideoBtn) {
            const vid = delVideoBtn.getAttribute('data-delete-video');
            state.videos = state.videos.filter((v) => v.id !== vid);
            saveState();
            renderAdminLists();
            renderMainView();
            showToast('Video removed');
          }
        });

        document.getElementById('exportJsonBtn').addEventListener('click', () => {
          const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'filmdrama-box-backup.json';
          a.click();
          URL.revokeObjectURL(url);
          showToast('Backup JSON exported');
        });

        document.getElementById('importJsonInput').addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (ev) => {
            try {
              const parsed = JSON.parse(ev.target.result);
              if (Array.isArray(parsed.folders) && Array.isArray(parsed.videos)) {
                state.folders = parsed.folders;
                state.videos = parsed.videos;
                state.subscribedFolderIds = Array.isArray(parsed.subscribedFolderIds) ? parsed.subscribedFolderIds : [];
                saveState();
                updateSubscribedBadge();
                renderAdminLists();
                renderMainView();
                showToast('Backup restored successfully');
              } else {
                showToast('Invalid backup file structure');
              }
            } catch (err) {
              showToast('Could not read JSON file');
            }
          };
          reader.readAsText(file);
        });

        document.getElementById('resetDemoDataBtn').addEventListener('click', () => {
          const currentProfile = state.profileName;
          state = JSON.parse(JSON.stringify(DEFAULT_DATA));
          state.profileName = currentProfile;
          saveState();
          updateSubscribedBadge();
          renderAdminLists();
          renderMainView();
          showToast('Default English catalog restored');
        });
      }

      // Initialize App
      renderHeaderProfile();
      updateSubscribedBadge();
      updateTabStyles();
      renderMainView();
      updateAdSlotDom('all');
      bindEvents();
      startAdClock();
    })();
  </script>
</body>
</html>
