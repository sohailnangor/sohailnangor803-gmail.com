        if (!state.videos.length) return;
        const idx = state.videos.findIndex((v) => v.id === currentPlayingVideoId);
        const nextIdx = idx === -1 ? 0 : (idx + 1) % state.videos.length;
        playVideo(state.videos[nextIdx].id);
