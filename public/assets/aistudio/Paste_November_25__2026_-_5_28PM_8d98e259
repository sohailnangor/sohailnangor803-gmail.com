      function startAdClock() {
        setInterval(() => {
          ['top', 'feed', 'bottomSafe'].forEach((key) => {
            const slot = adState[key];
            if (slot.cooldown > 0) {
              slot.cooldown -= 1;
              if (slot.cooldown <= 0) {
                slot.cooldown = 0;
                slot.remaining = 30;
                slot.index += 1;
                updateAdSlotDom(key);
              } else {
                updateAdSlotDom(null);
              }
            } else {
              slot.remaining -= 1;
              if (slot.remaining <= 0) {
                // Remove old ad and load new ad every 30 seconds
                slot.remaining = 30;
                slot.index += 1;
                updateAdSlotDom(key);
              } else {
                updateAdSlotDom(null);
              }
            }
          });
        }, 1000);
      }

