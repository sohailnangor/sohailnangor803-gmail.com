        const btn = document.getElementById('playerSubscribeBtn');
        const video = state.videos.find((v) => v.id === currentPlayingVideoId);
        if (!video || !video.folderId) {
          btn.classList.add('hidden');
          return;
        }
        btn.classList.remove('hidden');
        const subscribed = isFolderSubscribed(video.folderId);
        if (subscribed) {
          btn.textContent = 'Subscribed ✓';
          btn.className = 'px-3.5 py-1.5 rounded-full bg-zinc-800 border border-zinc-700 text-zinc-200 text-xs font-bold transition-colors';
