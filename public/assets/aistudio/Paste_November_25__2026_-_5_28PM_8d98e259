                  <button type="button" class="close-feed-ad-btn w-6 h-6 rounded-full bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-bold flex items-center justify-center" title="Hide ad for 60 seconds">&times;</button>
