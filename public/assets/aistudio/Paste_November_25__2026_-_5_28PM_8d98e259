          btn.textContent = 'Subscribe';
          btn.className = 'px-3.5 py-1.5 rounded-full bg-amber-400 hover:bg-amber-300 text-black text-xs font-extrabold transition-colors';
        }
        btn.onclick = () => toggleFolderSubscription(video.folderId);
      }

