            subscribedFolderIds: Array.isArray(parsed.subscribedFolderIds) ? parsed.subscribedFolderIds : []
          };
        } catch (e) {
          return JSON.parse(JSON.stringify(DEFAULT_DATA));
        }
      }

      function saveState() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (e) {
          console.error('Storage save failed:', e);
        }
      }

      function showToast(msg) {
        const toast = document.getElementById('toastBanner');
        toast.textContent = msg;
        toast.classList.remove('hidden');
        clearTimeout(showToast._timer);
        showToast._timer = setTimeout(() => {
          toast.classList.add('hidden');
        }, 2600);
      }

      function extractYouTubeId(input) {
        const clean = String(input || '').trim();
        if (/^[a-zA-Z0-9_-]{11}$/.test(clean)) return clean;
        const patterns = [
          /(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/|youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/,
          /[?&]v=([a-zA-Z0-9_-]{11})/
        ];
        for (const pattern of patterns) {
          const match = clean.match(pattern);
          if (match && match[1]) return match[1];
        }
        return null;
      }

      function getFolderById(folderId) {
        return state.folders.find((f) => f.id === folderId) || null;
      }

      function isFolderSubscribed(folderId) {
        return state.subscribedFolderIds.includes(folderId);
      }

      function toggleFolderSubscription(folderId) {
        if (!folderId) return;
        const idx = state.subscribedFolderIds.indexOf(folderId);
        const folder = getFolderById(folderId);
        if (idx === -1) {
          state.subscribedFolderIds.push(folderId);
          showToast(`Subscribed to ${folder ? folder.title : 'Series'}`);
        } else {
          state.subscribedFolderIds.splice(idx, 1);
          showToast(`Unsubscribed from ${folder ? folder.title : 'Series'}`);
        }
        saveState();
        updateSubscribedBadge();
        updatePlayerSubscribeButton();
        renderMainView();
      }

      function updateSubscribedBadge() {
        const badge = document.getElementById('subscribedCountBadge');
        badge.textContent = String(state.subscribedFolderIds.length);
      }

      function isAdminUnlocked(nameValue) {
        const raw = String(nameValue !== undefined ? nameValue : state.profileName).trim();
        const normalized = raw.toLowerCase().replace(/\s+/g, ' ');
        return (
          normalized === 'sohail nangoor 786' ||
          normalized === 'sohail nangoor' ||
          normalized === 'sohailnangoor786' ||
          normalized === 'admin' ||
          normalized === 'kingadmin' ||
          raw.includes('सोहेल नागौर 786') ||
          raw.includes('سہیل نانگو 786')
        );
      }

      function renderHeaderProfile() {
        const display = document.getElementById('profileDisplayName');
        const initial = document.getElementById('profileInitial');
        const cleanName = state.profileName || 'Guest';
        display.textContent = isAdminUnlocked(cleanName) ? 'Sohail Nangoor' : cleanName;
        initial.textContent = display.textContent.charAt(0).toUpperCase() || 'G';
      }

      // PLAY VIDEO IN FULL-BLEED STICKY PLAYER + SHOW SAFE-ZONE BOTTOM BANNER
      function playVideo(videoId) {
        const video = state.videos.find((v) => v.id === videoId);
        if (!video) return;

        currentPlayingVideoId = video.id;
        const section = document.getElementById('stickyPlayerSection');
        const iframe = document.getElementById('ytPlayerIframe');
        const titleEl = document.getElementById('playerVideoTitle');
        const catEl = document.getElementById('playerCategoryBadge');
        const folderBtn = document.getElementById('playerFolderJumpBtn');

        const embedUrl = `https://www.youtube.com/embed/${video.youtubeId}?autoplay=1&rel=0&modestbranding=1&playsinline=1&fs=1`;
        if (iframe.src !== embedUrl) {
          iframe.src = embedUrl;
        }

        titleEl.textContent = video.title;
        catEl.textContent = video.category;

        const folder = getFolderById(video.folderId);
        if (folder) {
          folderBtn.textContent = folder.title;
          folderBtn.onclick = () => {
            activeTab = 'Drama Box';
            selectedFolderId = folder.id;
            updateTabStyles();
            renderMainView();
          };
        } else {
          folderBtn.textContent = 'Single Release';
          folderBtn.onclick = null;
        }

        updatePlayerSubscribeButton();
        section.classList.remove('hidden');

        // Show AD_SLOT_BOTTOM_SAFE safely above mobile back button when video plays
        document.getElementById('adSlotBottomSafeWrapper').classList.remove('hidden');
        updateAdSlotDom();

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

