      function loadState() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return JSON.parse(JSON.stringify(DEFAULT_DATA));
          const parsed = JSON.parse(raw);
          return {
            profileName: parsed.profileName || 'Guest',
