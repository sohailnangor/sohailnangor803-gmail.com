      function syncToRemoteDataLayer(collectionName, payload) {
        if (!FIREBASE_CONFIG.enabled || !FIREBASE_CONFIG.databaseURL) return;
        // Ready hook for Firebase REST / SDK push when deployed live
        fetch(`${FIREBASE_CONFIG.databaseURL.replace(/\/$/, '')}/${collectionName}.json`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).catch(() => {});
