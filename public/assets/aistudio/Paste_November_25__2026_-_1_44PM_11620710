      function loadStateFromStorage() {
        try {
          const savedFolders = JSON.parse(localStorage.getItem(STORAGE_KEYS.FOLDERS) || 'null');
          state.folders = Array.isArray(savedFolders) && savedFolders.length > 0 ? savedFolders : [...DEFAULT_FOLDERS];

          const savedVideos = JSON.parse(localStorage.getItem(STORAGE_KEYS.VIDEOS) || 'null');
          state.videos = Array.isArray(savedVideos) && savedVideos.length > 0 ? savedVideos : [...DEFAULT_VIDEOS];

          const subFolders = JSON.parse(localStorage.getItem(STORAGE_KEYS.SUBSCRIBED_FOLDERS) || '[]');
          state.subscribedFolderIds = Array.isArray(subFolders) ? subFolders : [];

          const savedVids = JSON.parse(localStorage.getItem(STORAGE_KEYS.SAVED_VIDEOS) || '[]');
          state.savedVideoIds = Array.isArray(savedVids) ? savedVids : [];

          state.profileName = localStorage.getItem(STORAGE_KEYS.PROFILE) || '';
        } catch (err) {
          state.folders = [...DEFAULT_FOLDERS];
          state.videos = [...DEFAULT_VIDEOS];
          state.subscribedFolderIds = [];
          state.savedVideoIds = [];
          state.profileName = '';
        }
