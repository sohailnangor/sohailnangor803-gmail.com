```html
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FilmDrama Box — Film • Drama • Stories &amp; Drama Box</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #0b0b0d;
      color: #f4f4f5;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    /* Hide horizontal scrollbar on mobile category tabs */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    @keyframes fadeSlideIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fadeSlideIn 0.22s ease-out forwards;
    }

    @keyframes bannerSwapPulse {
      0% {
        opacity: 0.35;
        transform: scale(0.99);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    .banner-snappy-swap {
      animation: bannerSwapPulse 0.22s ease-out forwards;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#0b0b0d] text-zinc-100 selection:bg-red-600 selection:text-white">

  <!-- STICKY TOP YOUTUBE-STYLE HEADER -->
  <header class="sticky top-0 z-40 bg-[#0b0b0d]/95 backdrop-blur-md border-b border-zinc-800/80">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2">
      <!-- Brand Logo -->
      <button
        id="brandHomeBtn"
        type="button"
        class="flex items-center gap-2 shrink-0 text-left group focus:outline-none"
        aria-label="FilmDrama Box Home"
      >
        <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-red-600 to-rose-700 flex items-center justify-center shadow-lg shadow-red-600/25 group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4 text-white fill-current ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </span>
        <div class="leading-tight">
          <span class="font-extrabold text-base sm:text-lg tracking-tight text-white block">
            FilmDrama<span class="text-red-500">Box</span>
          </span>
          <span class="text-[10px] text-zinc-400 font-medium hidden sm:block">
            Film • Drama • Stories • Playlists
          </span>
        </div>
      </button>

      <!-- Search Input Bar -->
      <div class="flex-1 max-w-md mx-1 sm:mx-4">
        <div class="relative flex items-center">
          <svg class="w-4 h-4 text-zinc-400 absolute left-3 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="searchInput"
            type="search"
            placeholder="Search films, dramas, folders..."
            class="w-full bg-[#17171b] hover:bg-[#1e1e24] focus:bg-[#1e1e24] text-xs sm:text-sm text-white placeholder-zinc-400 pl-9 pr-8 py-2 rounded-full border border-zinc-800 focus:border-red-500/70 focus:outline-none transition-colors"
          />
          <button
            id="clearSearchBtn"
            type="button"
            class="hidden absolute right-2.5 text-zinc-400 hover:text-white text-xs p-1"
            aria-label="Clear search"
          >
            &times;
          </button>
        </div>
      </div>

      <!-- Right Controls: Admin Quick Button (when unlocked) + Profile Trigger -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <button
          id="headerAdminBtn"
          type="button"
          class="hidden items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 text-xs font-bold transition-colors"
          title="Open Admin Studio"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span class="hidden sm:inline">Admin</span>
        </button>

        <button
          id="profileTriggerBtn"
          type="button"
          class="flex items-center gap-2 pl-2 pr-2.5 py-1.5 rounded-full bg-[#17171b] hover:bg-[#222228] border border-zinc-800 transition-colors"
          aria-label="Profile and Admin Settings"
        >
          <span id="profileAvatarCircle" class="w-7 h-7 rounded-full bg-gradient-to-tr from-zinc-700 to-zinc-600 flex items-center justify-center text-xs font-bold text-white">
            <svg class="w-4 h-4 text-zinc-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </span>
          <span id="profileBadgeText" class="text-xs font-semibold text-zinc-200 max-w-[74px] truncate hidden xs:inline sm:inline">
            Profile
          </span>
        </button>
      </div>
    </div>

    <!-- MAIN NAVIGATION TABS (Home Feed, Drama Box / Folders, Film, Drama, Stories, Saved) -->
  <!-- MAIN NAVIGATION TABS (Home Feed, Drama Box / Folders, Film, Drama, Stories, Subscribed) -->
  <nav class="max-w-7xl mx-auto px-3 sm:px-6 pb-2.5 pt-1 flex items-center gap-2 overflow-x-auto no-scrollbar" aria-label="Primary Navigation">
    <button
      type="button"
      data-nav="All"
      class="nav-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-white text-black transition-all"
    >
      Home Feed (ہوم)
    </button>

    <button
      type="button"
      data-nav="Folders"
      class="nav-pill shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#18181d] text-zinc-200 hover:bg-[#24242b] border border-zinc-800 transition-all"
    >
      <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
      </svg>
      <span>Drama Box / Folders</span>
      <span id="subscribedFolderPillCount" class="px-1.5 py-0.2 rounded-full bg-amber-400/20 text-amber-300 text-[10px] font-bold">0</span>
    </button>

    <button
      type="button"
      data-nav="Film"
      class="nav-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#18181d] text-zinc-300 hover:bg-[#24242b] border border-zinc-800/80 transition-all"
    >
      Film (فلم)
    </button>

    <button
      type="button"
      data-nav="Drama"
      class="nav-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#18181d] text-zinc-300 hover:bg-[#24242b] border border-zinc-800/80 transition-all"
    >
      Drama (ڈرامہ)
    </button>

    <button
      type="button"
      data-nav="Stories"
      class="nav-pill shrink-0 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#18181d] text-zinc-300 hover:bg-[#24242b] border border-zinc-800/80 transition-all"
    >
      Stories (اسٹوریز)
    </button>

    <button
      type="button"
      data-nav="Subscribed"
      class="nav-pill shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#18181d] text-zinc-300 hover:bg-[#24242b] border border-zinc-800/80 transition-all"
    >
      <span>Subscribed (ان باکس)</span>
      <span id="savedCountPill" class="px-1.5 py-0.2 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold">0</span>
    </button>
  </nav>

  <!-- COMPACT SLIM TOP BANNER AD STRIP (AD_SLOT_TOP - Always Accessible & Non-Blocking) -->
  <div id="topPersistentBannerWrapper" class="max-w-7xl mx-auto px-3 sm:px-6 pb-2">
    <div
      id="topBannerAdBox"
      data-ad-slot="AD_SLOT_TOP"
      role="region"
      aria-label="Top Compact Banner Ad"
      class="rounded-xl bg-[#16161e] border border-amber-500/35 shadow-sm overflow-hidden"
    >
      <!-- Ready-to-Paste Live Ad Network Container (AD_SLOT_TOP) -->
      <div id="ad-network-slot-top" class="top-banner-body px-3 py-1.5 flex items-center justify-between gap-2">
        <a
          id="topBannerClickableLink"
          href="#foldersSection"
          class="flex items-center gap-2 min-w-0 flex-1 group"
        >
          <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold uppercase bg-amber-400 text-black shrink-0">
            AD
          </span>
          <span id="topBannerHeadline" class="text-xs font-semibold text-white group-hover:text-amber-300 truncate">
            Subscribe to Drama Folders • New Episodes Daily
          </span>
          <span class="hidden md:inline text-[11px] text-zinc-400 truncate">
            — <span id="topBannerSubtext">Tap ad (video stays playing)</span>
          </span>
        </a>

        <div class="flex items-center gap-1.5 shrink-0">
          <span id="topBannerCountdown" class="text-[10px] font-bold text-amber-300 bg-black/50 px-1.5 py-0.5 rounded">
            30s
          </span>
          <button
            id="topCycleBannerBtn"
            type="button"
            class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 text-[10px] text-zinc-200 font-semibold transition-colors"
            title="Next banner ad"
          >
            Next
          </button>
          <button
            id="topCloseBannerBtn"
            type="button"
            class="w-5 h-5 rounded bg-zinc-800 hover:bg-red-600 text-zinc-200 hover:text-white flex items-center justify-center font-bold text-xs transition-colors"
            title="Hide for 60 seconds"
            aria-label="Close top banner ad for 60 seconds"
          >
            &times;
          </button>
        </div>
      </div>

      <div class="w-full h-0.5 bg-white/10">
        <div id="topBannerProgress" class="h-full bg-amber-400 transition-all duration-200 ease-linear" style="width: 100%;"></div>
      </div>
    </div>

    <!-- Slim Re-Open Strip When Hidden for 60s -->
    <div id="topBannerHiddenStrip" class="hidden items-center justify-between px-3 py-1 rounded-xl bg-[#141419] border border-zinc-800 text-[11px] text-zinc-400">
      <span>Top banner ad paused for 60s</span>
      <button
        id="topReopenBannerBtn"
        type="button"
        class="text-amber-300 hover:text-amber-200 font-bold underline"
      >
        Show Ad Now
      </button>
    </div>
  </div>
</header>

<!-- MAIN CONTENT CONTAINER -->
<main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6 space-y-5">

  <!-- STICKY / ACTIVE YOUTUBE-STYLE VIDEO PLAYER VIEW -->
  <section id="playerSection" class="hidden bg-[#131317] rounded-2xl p-3 sm:p-4 border border-zinc-800/90 space-y-3 animate-fade-in">
      <!-- Top Bar inside Player -->
      <div class="flex items-center justify-between gap-2">
        <button
          id="backFromPlayerBtn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1d1d23] hover:bg-[#282830] border border-zinc-700/80 text-xs sm:text-sm font-semibold text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span id="backFromPlayerLabel">Back to Feed</span>
        </button>

        <div class="flex items-center gap-2">
          <button
            id="reopenBannerBtn"
            type="button"
            class="hidden inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 text-xs font-medium transition-colors"
          >
            <span>Show Ads</span>
          </button>

          <button
            id="playerSaveBtn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#1d1d23] hover:bg-[#282830] border border-zinc-700/80 text-xs sm:text-sm font-semibold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
            <span id="playerSaveText">Save</span>
          </button>
        </div>
      </div>

      <!-- Sticky 16:9 Responsive YouTube Embed Frame -->
      <div class="sticky top-14 sm:top-16 z-30 w-full rounded-2xl overflow-hidden bg-black border border-zinc-800 shadow-2xl">
        <div class="relative w-full aspect-video max-h-[34vh] sm:max-h-[48vh] mx-auto bg-black">
          <iframe
            id="ytPlayerFrame"
            class="w-full h-full"
            src=""
            title="Video Player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <!-- Video Title + Folder Badge + Subscribe Button Strip -->
        <div class="px-3.5 py-2.5 bg-[#17171c] border-t border-zinc-800/90 space-y-2">
          <div class="flex items-start justify-between gap-2">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-1.5">
                <span id="playingCategoryBadge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-600/20 text-red-400 border border-red-500/30">
                  Drama
                </span>
                <span id="playingDurationBadge" class="text-[11px] text-zinc-400 font-medium"></span>
              </div>
              <h1 id="playingTitle" class="text-sm sm:text-base font-bold text-white mt-1 line-clamp-2">
                Select a video to watch
              </h1>
            </div>
          </div>

          <!-- Folder / Series Quick Subscribe Row (Shown whenever video belongs to a Folder) -->
          <div id="playerFolderBar" class="hidden pt-2 border-t border-zinc-800/80 flex items-center justify-between gap-2">
            <button
              id="playerOpenFolderBtn"
              type="button"
              class="flex items-center gap-2 min-w-0 text-left group"
            >
              <span class="w-8 h-8 rounded-lg bg-amber-500/15 border border-amber-500/30 flex items-center justify-center shrink-0 text-amber-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
                </svg>
              </span>
              <div class="min-w-0">
                <span class="text-[10px] uppercase tracking-wider text-zinc-400 block">Drama / Film Folder</span>
                <span id="playerFolderTitle" class="text-xs sm:text-sm font-bold text-amber-300 group-hover:underline truncate block">
                  Drama Series
                </span>
              </div>
            </button>

            <button
              id="playerFolderSubscribeBtn"
              type="button"
              class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-400 hover:bg-amber-300 text-black transition-colors shadow"
            >
              Subscribe
            </button>
          </div>
        </div>
      </div>

      <!-- COMPACT SLIM HORIZONTAL BANNER AD STRIP DIRECTLY BELOW PLAYER (AD_SLOT_1 - 30s Auto-Rotate) -->
      <div
        id="watchAreaBannerBox"
        data-ad-slot="AD_SLOT_1"
        role="region"
        aria-label="Compact Banner Ad Strip"
        class="rounded-xl bg-[#16161e] border border-amber-500/35 shadow-md overflow-hidden"
      >
        <!-- Ready-to-Paste Live Ad Network Container (AD_SLOT_1) -->
        <div id="ad-network-slot-watch" class="watch-banner-body px-3 py-1.5 flex items-center justify-between gap-2">
          <a
            id="watchBannerClickableLink"
            href="#foldersSection"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 min-w-0 flex-1 group"
          >
            <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold uppercase bg-amber-400 text-black shrink-0">
              AD
            </span>
            <span id="watchBannerHeadline" class="text-xs font-semibold text-white group-hover:text-amber-300 truncate">
              Subscribe to Drama Folders • New Episodes Daily
            </span>
            <span class="hidden sm:inline text-[11px] text-zinc-400 truncate">
              — <span id="watchBannerSubtext">Tap ad (video stays playing)</span>
            </span>
          </a>

          <div class="flex items-center gap-1.5 shrink-0">
            <span id="watchBannerCountdown" class="text-[10px] font-bold text-amber-300 bg-black/50 px-1.5 py-0.5 rounded">
              30s
            </span>
            <button
              id="cycleBannerNowBtn"
              type="button"
              class="px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 text-[10px] text-zinc-200 font-semibold transition-colors"
              title="Next banner ad"
            >
              Next
            </button>
            <button
              id="closeBannerAdBtn"
              type="button"
              class="w-5 h-5 rounded bg-zinc-800 hover:bg-red-600 text-zinc-200 hover:text-white flex items-center justify-center font-bold text-xs transition-colors"
              title="Hide for 60 seconds"
              aria-label="Close banner ad for 60 seconds"
            >
              &times;
            </button>
          </div>
        </div>

        <div class="w-full h-0.5 bg-white/10">
          <div id="watchBannerProgress" class="h-full bg-amber-400 transition-all duration-200 ease-linear" style="width: 100%;"></div>
        </div>
      </div>

      <!-- UP NEXT / PLAYLIST EPISODES INSIDE WATCH VIEW -->
      <div id="playerRelatedSection" class="pt-1 space-y-3">
        <div class="flex items-center justify-between">
          <h3 id="playerRelatedHeading" class="text-xs sm:text-sm font-bold text-zinc-200">
            More Episodes &amp; Recommended Videos
          </h3>
          <span id="playerRelatedCount" class="text-[11px] text-zinc-400"></span>
        </div>
        <div id="playerRelatedGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5"></div>
      </div>
    </section>

    <!-- DEDICATED DRAMA BOX / PLAYLIST FOLDERS PAGE -->
    <section id="foldersSection" class="hidden space-y-5 pb-20 animate-fade-in">
      <!-- Page Header + Filter Chips (All Folders / Subscribed / Drama Folders / Film Folders) -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[#141419] p-4 rounded-2xl border border-zinc-800/90">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-base sm:text-lg font-extrabold text-white">Drama Box &amp; Film Folders</h2>
            <span id="foldersTotalBadge" class="px-2 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-[11px] font-bold">
              0 Folders
            </span>
          </div>
          <p class="text-xs text-zinc-400 mt-0.5">
            Subscribe to any Drama or Film folder to get its latest episodes right at the top.
          </p>
        </div>

        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
          <button
            type="button"
            data-folder-filter="All"
            class="folder-filter-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-400 text-black transition-colors"
          >
            All Folders
          </button>
          <button
            type="button"
            data-folder-filter="Subscribed"
            class="folder-filter-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#1d1d24] text-zinc-300 hover:bg-[#272730] border border-zinc-800 transition-colors"
          >
            Subscribed (<span id="subTabInnerCount">0</span>)
          </button>
          <button
            type="button"
            data-folder-filter="Drama"
            class="folder-filter-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#1d1d24] text-zinc-300 hover:bg-[#272730] border border-zinc-800 transition-colors"
          >
            Drama Folders
          </button>
          <button
            type="button"
            data-folder-filter="Film"
            class="folder-filter-btn shrink-0 px-3 py-1.5 rounded-xl text-xs font-semibold bg-[#1d1d24] text-zinc-300 hover:bg-[#272730] border border-zinc-800 transition-colors"
          >
            Film Folders
          </button>
        </div>
      </div>

      <!-- SUBSCRIBED FOLDERS INBOX STRIP (Always shows newest episodes from subscribed folders) -->
      <div id="subscribedInboxCard" class="hidden bg-gradient-to-br from-[#1b1712] via-[#15151b] to-[#121920] rounded-2xl p-4 border border-amber-500/35 space-y-3">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
            <h3 class="text-sm sm:text-base font-extrabold text-amber-300">
              My Subscribed Drama &amp; Film Inbox
            </h3>
          </div>
          <span id="subscribedLatestBadge" class="text-[11px] font-semibold text-zinc-300"></span>
        </div>

        <!-- Horizontal Quick Chips for Subscribed Folders -->
        <div id="subscribedFolderChips" class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1"></div>

        <!-- Latest Episodes Grid from Subscribed Folders -->
        <div id="subscribedLatestEpisodesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 pt-1"></div>
      </div>

      <!-- ALL / FILTERED FOLDERS GRID -->
      <div id="foldersGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>

      <!-- Empty State for Folders -->
      <div id="foldersEmptyState" class="hidden text-center py-14 px-4 bg-[#131318] rounded-2xl border border-zinc-800/80 space-y-2">
        <p class="text-sm sm:text-base font-bold text-zinc-200">No folders found in this filter</p>
        <p class="text-xs text-zinc-400 max-w-md mx-auto">
          Switch filter tabs above, or unlock Admin Studio (<code class="text-amber-300">KINGADMIN</code>) to create new Drama &amp; Film folders.
        </p>
      </div>
