        if (els.watchBannerSubtext) els.watchBannerSubtext.textContent = slot.subtext;
        if (els.watchBannerCountdown) els.watchBannerCountdown.textContent = `${state.bannerSecondsLeft}s`;
        if (els.watchBannerProgress) els.watchBannerProgress.style.width = `${pct}%`;

        if (els.topBannerHeadline) els.topBannerHeadline.textContent = slot.headline;
        if (els.topBannerSubtext) els.topBannerSubtext.textContent = slot.subtext;
        if (els.topBannerCountdown) els.topBannerCountdown.textContent = `${state.bannerSecondsLeft}s`;
        if (els.topBannerProgress) els.topBannerProgress.style.width = `${pct}%`;

        document.querySelectorAll('.in-feed-banner-slot').forEach((bannerEl) => {
          const headEl = bannerEl.querySelector('.feed-banner-headline');
          const subEl = bannerEl.querySelector('.feed-banner-subtext');
          const countEl = bannerEl.querySelector('.feed-banner-countdown');
          const progEl = bannerEl.querySelector('.feed-banner-progress');

          if (headEl) headEl.textContent = slot.headline;
          if (subEl) subEl.textContent = slot.subtext;
          if (countEl) countEl.textContent = `${state.bannerSecondsLeft}s`;
          if (progEl) progEl.style.width = `${pct}%`;
        });
      }

      function rotateToNextBanner() {
        state.bannerIndex = (state.bannerIndex + 1) % BANNER_SLOTS.length;
        state.bannerSecondsLeft = BANNER_ROTATION_SECONDS;
        syncBannerDOM();
      }

      function startBannerRotation() {
        if (bannerTimerId) clearInterval(bannerTimerId);
        bannerTimerId = setInterval(() => {
          const hiddenByCooldown = isBannerCurrentlyHidden();

          if (!hiddenByCooldown && state.bannerHiddenUntil !== 0) {
            state.bannerHiddenUntil = 0;
            state.closedFeedBannerRows = {};
            syncWatchBannerVisibility();
            renderActiveViews();
          }

          if (hiddenByCooldown) return;

          state.bannerSecondsLeft -= 1;
          if (state.bannerSecondsLeft <= 0) {
            rotateToNextBanner();
          } else {
            syncBannerDOM();
          }
        }, 1000);
      }

      function syncWatchBannerVisibility() {
        if (!isBannerCurrentlyHidden()) {
          els.watchAreaBannerBox.classList.remove('hidden');
          els.reopenBannerBtn.classList.add('hidden');
          if (els.topBannerAdBox) els.topBannerAdBox.classList.remove('hidden');
          if (els.topBannerHiddenStrip) {
            els.topBannerHiddenStrip.classList.add('hidden');
            els.topBannerHiddenStrip.classList.remove('flex');
          }
        } else {
          els.watchAreaBannerBox.classList.add('hidden');
          els.reopenBannerBtn.classList.remove('hidden');
          if (els.topBannerAdBox) els.topBannerAdBox.classList.add('hidden');
          if (els.topBannerHiddenStrip) {
            els.topBannerHiddenStrip.classList.remove('hidden');
            els.topBannerHiddenStrip.classList.add('flex');
          }
        }
      }

      // =========================================================================
      // ADMIN STUDIO MODAL LOGIC (3 TABS: CREATE FOLDER, ADD LINK, MANAGE)
      // =========================================================================
      function switchAdminTab(tabName) {
        document.querySelectorAll('.admin-tab-btn').forEach((btn) => {
          const key = btn.getAttribute('data-admin-tab');
          if (key === tabName) {
            btn.className = 'admin-tab-btn py-2 px-2 rounded-lg text-xs font-bold bg-amber-400 text-black transition-colors';
          } else {
            btn.className = 'admin-tab-btn py-2 px-2 rounded-lg text-xs font-semibold text-zinc-300 hover:text-white transition-colors';
          }
        });

        els.createFolderForm.classList.toggle('hidden', tabName !== 'createFolder');
        els.addVideoForm.classList.toggle('hidden', tabName !== 'addVideo');
        els.manageAllPanel.classList.toggle('hidden', tabName !== 'manageAll');

        populateAdminFolderSelect();
        renderAdminManageLists();
      }

      function populateAdminFolderSelect() {
        const currentVal = els.videoFolderSelect.value;
        const optionsHtml = [
          `<option value="">-- Standalone (Home Feed Only) --</option>`,
          ...state.folders.map(
            (f) =>
              `<option value="${escapeHtml(f.id)}">[${escapeHtml(f.category)}] ${escapeHtml(f.title)}</option>`
          )
        ];
        els.videoFolderSelect.innerHTML = optionsHtml.join('');
        if (currentVal && state.folders.some((f) => f.id === currentVal)) {
          els.videoFolderSelect.value = currentVal;
        }
      }

      function renderAdminManageLists() {
        els.adminFolderCount.textContent = `${state.folders.length} Folders`;
        els.adminFoldersList.innerHTML = state.folders
          .map((f) => {
            const count = state.videos.filter((v) => v.folderId === f.id).length;
            return `
              <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#0e0e12] border border-zinc-800">
                <div class="min-w-0">
                  <span class="text-[10px] font-bold uppercase text-amber-400">${escapeHtml(f.category)} • ${count} items</span>
                  <p class="text-xs font-bold text-white truncate">${escapeHtml(f.title)}</p>
                </div>
                <button
                  type="button"
                  data-delete-folder="${escapeHtml(f.id)}"
                  class="shrink-0 px-2.5 py-1 rounded-lg bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white text-[11px] font-bold transition-colors"
                >
                  Delete
                </button>
              </div>
            `;
          })
          .join('');

        els.adminVideoCount.textContent = `${state.videos.length} Videos`;
        els.adminVideosList.innerHTML = state.videos
          .map((v) => {
            const folder = v.folderId ? state.folders.find((f) => f.id === v.folderId) : null;
            return `
              <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-[#0e0e12] border border-zinc-800">
                <div class="min-w-0">
                  <span class="text-[10px] font-semibold text-zinc-400">
                    ${escapeHtml(v.category)}${folder ? ` • Folder: ${escapeHtml(folder.title)}` : ''}
                  </span>
                  <p class="text-xs font-bold text-white truncate">${escapeHtml(v.title)}</p>
                </div>
                <button
                  type="button"
                  data-delete-video="${escapeHtml(v.id)}"
                  class="shrink-0 px-2.5 py-1 rounded-lg bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white text-[11px] font-bold transition-colors"
                >
                  Delete
                </button>
              </div>
            `;
          })
          .join('');
      }

      function openAdminStudio(defaultTab = 'createFolder') {
        switchAdminTab(defaultTab);
        els.adminModal.classList.remove('hidden');
      }

      // =========================================================================
      // GLOBAL EVENT LISTENERS & DELEGATION
      // =========================================================================
      function bindEvents() {
        // Brand Logo -> Home Feed
        els.brandHomeBtn.addEventListener('click', () => {
          state.searchQuery = '';
          els.searchInput.value = '';
          els.clearSearchBtn.classList.add('hidden');
          setActiveNavigation('All');
        });

        // Search Input
        els.searchInput.addEventListener('input', (e) => {
          state.searchQuery = e.target.value;
          els.clearSearchBtn.classList.toggle('hidden', !state.searchQuery);
          renderActiveViews();
        });

        els.clearSearchBtn.addEventListener('click', () => {
          state.searchQuery = '';
          els.searchInput.value = '';
          els.clearSearchBtn.classList.add('hidden');
          renderActiveViews();
        });

        // Navigation Pills
        document.querySelectorAll('.nav-pill').forEach((pill) => {
          pill.addEventListener('click', () => {
            const target = pill.getAttribute('data-nav');
            if (target) setActiveNavigation(target);
          });
        });

        els.feedOpenFoldersShortcut.addEventListener('click', () => {
          setActiveNavigation('Folders');
        });

        // Folder Filter Buttons on Drama Box Page
        document.querySelectorAll('.folder-filter-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            state.folderFilter = btn.getAttribute('data-folder-filter') || 'All';
            renderFoldersPage();
          });
        });

        // Folder Detail Back & Subscribe
        els.backFromFolderDetailBtn.addEventListener('click', () => {
          state.activeFolderDetailId = null;
          state.activeNav = 'Folders';
          setActiveNavigation('Folders');
        });

        els.detailFolderSubscribeBtn.addEventListener('click', () => {
          if (state.activeFolderDetailId) {
            toggleFolderSubscribe(state.activeFolderDetailId);
          }
        });

        // Player Controls
        els.backFromPlayerBtn.addEventListener('click', () => {
          closeVideoPlayer();
        });

        els.playerSaveBtn.addEventListener('click', () => {
          if (state.activeVideoId) toggleVideoSave(state.activeVideoId);
        });

        els.playerOpenFolderBtn.addEventListener('click', () => {
          const video = state.videos.find((v) => v.id === state.activeVideoId);
          if (video && video.folderId) {
            openFolderDetail(video.folderId);
          }
        });

        els.playerFolderSubscribeBtn.addEventListener('click', () => {
          const video = state.videos.find((v) => v.id === state.activeVideoId);
          if (video && video.folderId) {
            toggleFolderSubscribe(video.folderId);
          }
        });

        // Watch Banner Controls
        els.cycleBannerNowBtn.addEventListener('click', () => {
          rotateToNextBanner();
        // Watch Banner Controls (30s rotation + 60s close cooldown + non-blocking click)
        els.cycleBannerNowBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          rotateToNextBanner();
        });

        els.closeBannerAdBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          hideBannersForCooldown();
        });

        els.reopenBannerBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          restoreBannersImmediately();
        });

        els.watchBannerClickableLink.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          applyBannerAction();
        });

        // Top Persistent Banner Controls (AD_SLOT_TOP)
        if (els.topCycleBannerBtn) {
          els.topCycleBannerBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            rotateToNextBanner();
          });
        }

        if (els.topCloseBannerBtn) {
          els.topCloseBannerBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            hideBannersForCooldown();
          });
        }

        if (els.topReopenBannerBtn) {
          els.topReopenBannerBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            restoreBannersImmediately();
          });
        }

        if (els.topBannerClickableLink) {
          els.topBannerClickableLink.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            applyBannerAction();
          });
        }
        });

        // Admin Studio Modal Tabs & Forms
        els.closeAdminModalBtn.addEventListener('click', () => {
          els.adminModal.classList.add('hidden');
        });

        document.querySelectorAll('.admin-tab-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            switchAdminTab(btn.getAttribute('data-admin-tab'));
          });
        });

        // Tab 1: Create New Folder
        els.createFolderForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const title = els.folderNameInput.value.trim();
          const category = els.folderCategoryInput.value === 'Film' ? 'Film' : 'Drama';
          const coverRaw = els.folderCoverInput.value.trim();
          const desc = els.folderDescInput.value.trim();

          if (!title) return;

          const newFolder = {
            id: `folder-${Date.now()}`,
            title,
            category,
            description: desc || `${category} playlist folder on FilmDrama Box`,
            coverUrl: resolveCoverUrl(coverRaw, ''),
            createdAt: Date.now()
          };

          state.folders.unshift(newFolder);
          saveFoldersToStorage();

          els.createFolderForm.reset();
          populateAdminFolderSelect();
          els.videoFolderSelect.value = newFolder.id;
          els.videoCategoryInput.value = category;

          showToast(`Created "${title}" folder!`);
          switchAdminTab('addVideo');
          renderActiveViews();
        });

        // Tab 2: Add Video / Episode Link
        els.addVideoForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const ytId = extractYouTubeId(els.videoUrlOrIdInput.value);
          const title = els.videoTitleInput.value.trim();
          const category = els.videoCategoryInput.value;
          const folderId = els.videoFolderSelect.value;
          const duration = els.videoDurationInput.value.trim() || '35:00';
          const customThumb = els.videoThumbInput.value.trim();

          if (!ytId) {
            showToast('Please enter a valid YouTube URL or 11-character ID');
            return;
          }
          if (!title) return;

          const newVideo = {
            id: `vid-${Date.now()}`,
            youtubeId: ytId,
            title,
            category,
            folderId: folderId || '',
            duration,
            thumbnail: customThumb || `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`,
            createdAt: Date.now()
          };

          state.videos.unshift(newVideo);

          // Update folder cover automatically if folder still has placeholder cover
          if (folderId) {
            const targetFolder = state.folders.find((f) => f.id === folderId);
            if (targetFolder && targetFolder.coverUrl.includes('placehold.co')) {
              targetFolder.coverUrl = newVideo.thumbnail;
              saveFoldersToStorage();
            }
          }

          saveVideosToStorage();
          els.addVideoForm.reset();
          els.videoDurationInput.value = '38:20';
          if (folderId) els.videoFolderSelect.value = folderId;

          showToast(
            folderId
              ? 'Published to Home Feed & Folder!'
              : 'Published to Home Feed!'
          );
          renderActiveViews();
        });

        // Delegated Clicks across Dynamic Cards, Folders, Inline Banners & Admin Lists
        document.addEventListener('click', (e) => {
          const playEl = e.target.closest('[data-play-video]');
          if (playEl) {
            playVideo(playEl.getAttribute('data-play-video'));
            return;
          }

          const openFolderEl = e.target.closest('[data-open-folder]');
          if (openFolderEl) {
            openFolderDetail(openFolderEl.getAttribute('data-open-folder'));
            return;
          }

          const subFolderEl = e.target.closest('[data-sub-folder]');
          if (subFolderEl) {
            e.stopPropagation();
            toggleFolderSubscribe(subFolderEl.getAttribute('data-sub-folder'));
            return;
          }

          const saveVideoEl = e.target.closest('[data-save-video]');
          if (saveVideoEl) {
            e.stopPropagation();
            toggleVideoSave(saveVideoEl.getAttribute('data-save-video'));
            return;
          }

          const closeRowEl = e.target.closest('[data-close-feed-row]');
          if (closeRowEl) {
            e.stopPropagation();
            hideBannersForCooldown();
            return;
          }

          const bannerCtaEl = e.target.closest('[data-trigger-banner-action]');
          if (bannerCtaEl) {
            e.preventDefault();
            e.stopPropagation();
            applyBannerAction();
            return;
          }

          const delFolderEl = e.target.closest('[data-delete-folder]');
          if (delFolderEl) {
            const fId = delFolderEl.getAttribute('data-delete-folder');
            state.folders = state.folders.filter((f) => f.id !== fId);
            state.videos = state.videos.map((v) => (v.folderId === fId ? { ...v, folderId: '' } : v));
            state.subscribedFolderIds = state.subscribedFolderIds.filter((id) => id !== fId);
            saveFoldersToStorage();
            saveVideosToStorage();
            saveSubscriptionsToStorage();
            populateAdminFolderSelect();
            renderAdminManageLists();
            updateCountersAndHeader();
            renderActiveViews();
            showToast('Folder deleted');
            return;
          }

          const delVideoEl = e.target.closest('[data-delete-video]');
          if (delVideoEl) {
            const vId = delVideoEl.getAttribute('data-delete-video');
            state.videos = state.videos.filter((v) => v.id !== vId);
            state.savedVideoIds = state.savedVideoIds.filter((id) => id !== vId);
            saveVideosToStorage();
            saveBookmarksToStorage();
            renderAdminManageLists();
            updateCountersAndHeader();
            renderActiveViews();
            showToast('Video removed');
          }
        });
      }

      // =========================================================================
      // INITIALIZE APPLICATION
      // =========================================================================
      loadStateFromStorage();
      bindEvents();
      updateCountersAndHeader();
      setActiveNavigation('All');
      startBannerRotation();
    })();
  </script>
</body>
</html>
