      function renderHomeFeed() {
        const query = state.searchQuery.trim().toLowerCase();

        const headingMap = {
          All: 'Latest Films, Dramas & Stories',
          Film: 'Full Films & Movies (فلم)',
          Drama: 'Drama Episodes & Serials (ڈرامہ)',
          Stories: 'Emotional & Viral Stories (اسٹوریز)',
          Subscribed: 'Subscribed Drama Inbox & Saved'
        };
        els.feedHeading.textContent = headingMap[state.activeNav] || 'Latest Videos';

        const filtered = state.videos.filter((video) => {
          if (state.activeNav === 'Subscribed') {
            const fromSubFolder = video.folderId && isFolderSubscribed(video.folderId);
            const isSaved = isVideoSaved(video.id);
            if (!fromSubFolder && !isSaved) return false;
          }
          if (['Film', 'Drama', 'Stories'].includes(state.activeNav) && video.category !== state.activeNav) {
            return false;
          }
          if (query) {
            const folder = video.folderId ? state.folders.find((f) => f.id === video.folderId) : null;
            const hay = `${video.title} ${video.category} ${folder ? folder.title : ''}`.toLowerCase();
            if (!hay.includes(query)) return false;
          }
          return true;
        });

        // Prioritize newest episodes from subscribed folders when viewing All or Subscribed
        const ordered = [...filtered].sort((a, b) => {
          const aSub = a.folderId && isFolderSubscribed(a.folderId) ? 1 : 0;
          const bSub = b.folderId && isFolderSubscribed(b.folderId) ? 1 : 0;
          if (state.activeNav === 'Subscribed' && aSub !== bSub) {
            return bSub - aSub;
          }
          return (b.createdAt || 0) - (a.createdAt || 0);
        });

        els.resultCountBadge.textContent = String(ordered.length);

        if (ordered.length === 0) {
          els.videoGrid.innerHTML = '';
          els.emptyState.classList.remove('hidden');
          return;
        }

        els.emptyState.classList.add('hidden');

        // Chunk videos into clean rows with slim rotating banner strips between rows
        const chunkSize = 2;
        const htmlChunks = [];
        let rowIdx = 0;
        const bannersAllowed = !isBannerCurrentlyHidden();

        for (let i = 0; i < ordered.length; i += chunkSize) {
          const slice = ordered.slice(i, i + chunkSize);
          htmlChunks.push(`
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
              ${slice.map((video) => buildVideoCardHtml(video)).join('')}
            </div>
          `);

          if (
            bannersAllowed &&
            i + chunkSize < ordered.length &&
            !state.closedFeedBannerRows[rowIdx]
          ) {
            htmlChunks.push(buildInFeedBannerHtml(rowIdx));
          }
          rowIdx += 1;
        }

        els.videoGrid.innerHTML = htmlChunks.join('');
      }

