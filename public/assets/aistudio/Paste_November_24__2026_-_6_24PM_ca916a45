```html
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FilmDrama Box — Films, Dramas &amp; Stories</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* Base dark styling and smooth transitions */
    :root {
      color-scheme: dark;
    }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: #0f0f0f;
      color: #f1f1f1;
      overflow-x: hidden;
    }
    /* Custom subtle scrollbars for category chips on mobile */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    /* Subtle card hover & banner transition */
    .video-card:hover .thumb-img {
      transform: scale(1.03);
    }
    .thumb-img {
      transition: transform 0.25s ease;
    }
    @keyframes fadeSlideIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in {
      animation: fadeSlideIn 0.24s ease-out forwards;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#0f0f0f] text-[#f1f1f1] selection:bg-red-600 selection:text-white">

  <!-- TOP HEADER BAR -->
  <header class="sticky top-0 z-40 bg-[#0f0f0f]/95 backdrop-blur-md border-b border-zinc-800/90">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
      <!-- Left: App Brand -->
      <button
        id="brandHomeBtn"
        type="button"
        class="flex items-center gap-2.5 text-left shrink-0 focus:outline-none group"
        title="FilmDrama Box Home"
      >
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-red-600 to-rose-700 flex items-center justify-center shadow-lg shadow-red-900/30 group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 text-white fill-current ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
        </div>
        <div class="leading-tight">
          <span class="font-extrabold tracking-tight text-base sm:text-lg text-white block">
            FilmDrama<span class="text-red-500">Box</span>
          </span>
          <span class="hidden sm:block text-[10px] tracking-wide text-zinc-400 font-medium">
            فلم • ڈرامہ • اسٹوریز
          </span>
        </div>
      </button>

      <!-- Center: Real-Time Search Bar -->
      <div class="flex-1 max-w-xl mx-1 sm:mx-2">
        <div class="relative flex items-center">
          <span class="absolute left-3 text-zinc-400 pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.35-4.35" stroke-linecap="round" />
            </svg>
          </span>
          <input
            id="searchInput"
            type="search"
            autocomplete="off"
            placeholder="Search title or category..."
            class="w-full bg-[#181818] hover:bg-[#1f1f1f] focus:bg-[#181818] text-sm text-white placeholder-zinc-400 pl-9 pr-9 py-2 rounded-full border border-zinc-700/80 focus:border-red-500 focus:outline-none transition-colors"
          />
          <button
            id="clearSearchBtn"
            type="button"
            class="hidden absolute right-2.5 text-zinc-400 hover:text-white p-1 rounded-full"
            title="Clear search"
            aria-label="Clear search"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Right: Admin Quick Pill (only visible when unlocked) + Profile Button -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <button
          id="adminQuickBtn"
          type="button"
          class="hidden items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-full bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 text-xs font-semibold transition-colors"
          title="Open Admin Panel"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span class="hidden md:inline">Admin</span>
        </button>

        <button
          id="profileBtn"
          type="button"
          class="flex items-center gap-2 pl-1.5 pr-2.5 py-1 rounded-full bg-[#1b1b1b] hover:bg-[#262626] border border-zinc-700/80 transition-colors"
          title="Profile &amp; Settings"
          aria-label="Open profile modal"
        >
          <div id="profileAvatarBadge" class="w-7 h-7 rounded-full bg-zinc-700 flex items-center justify-center text-xs font-bold text-white shrink-0">
            <svg class="w-4 h-4 text-zinc-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <span id="headerProfileLabel" class="hidden sm:inline text-xs font-medium text-zinc-200 max-w-[110px] truncate">
            Guest
          </span>
        </button>
      </div>
    </div>

    <!-- CATEGORY FILTER TABS -->
    <div class="border-t border-zinc-800/70 bg-[#0f0f0f]">
      <div id="categoryTabs" class="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 flex items-center gap-2 overflow-x-auto no-scrollbar">
        <button data-category="All" class="cat-tab active px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap transition-all bg-white text-black">
          All
        </button>
        <button data-category="Film" class="cat-tab px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium whitespace-nowrap transition-all bg-[#222222] text-zinc-200 hover:bg-[#2f2f2f]">
          Film (فلم)
        </button>
        <button data-category="Drama" class="cat-tab px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium whitespace-nowrap transition-all bg-[#222222] text-zinc-200 hover:bg-[#2f2f2f]">
          Drama (ڈرامہ)
        </button>
        <button data-category="Stories" class="cat-tab px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium whitespace-nowrap transition-all bg-[#222222] text-zinc-200 hover:bg-[#2f2f2f]">
          Stories (اسٹوریز)
        </button>
        <button data-category="Saved" class="cat-tab px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium whitespace-nowrap transition-all bg-[#222222] text-zinc-200 hover:bg-[#2f2f2f] flex items-center gap-1.5">
          <span>Saved</span>
          <span id="savedCountPill" class="px-1.5 py-0.2 text-[11px] rounded-full bg-zinc-700 text-zinc-100 font-bold">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- STATUS / TOAST BANNER (Non-blocking notification bar) -->
  <div id="toastBar" class="hidden fixed bottom-4 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-xs sm:text-sm text-white shadow-2xl items-center gap-2.5 max-w-[92vw]">
    <span class="w-2 h-2 rounded-full bg-red-500 shrink-0"></span>
    <span id="toastMessage">Updated</span>
  </div>

  <!-- MAIN CONTENT AREA -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 py-4 sm:py-6 space-y-6">

    <!-- ACTIVE VIDEO PLAYER VIEW (Hidden until a video card is selected) -->
    <section id="playerSection" class="hidden animate-fade-in space-y-4">
      <!-- Top Player Controls Bar -->
      <div class="flex flex-wrap items-center justify-between gap-2">
        <button
          id="backToFeedBtn"
          type="button"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#1d1d1d] hover:bg-[#2a2a2a] border border-zinc-700/80 text-xs sm:text-sm font-semibold text-white transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Back to Feed</span>
        </button>

        <div class="flex items-center gap-2">
          <button
            id="reopenBannerBtn"
            type="button"
            class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 border border-amber-500/40 text-amber-300 text-xs font-medium transition-colors"
          >
            <span>Show Banner Ad</span>
          </button>
          <button
            id="playerSaveBtn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#1d1d1d] hover:bg-[#2a2a2a] border border-zinc-700/80 text-xs sm:text-sm font-semibold transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
            </svg>
            <span id="playerSaveText">Save</span>
          </button>
        </div>
      </div>

      <!-- 16:9 Responsive YouTube Embed Container -->
      <div class="w-full rounded-2xl overflow-hidden bg-black border border-zinc-800 shadow-2xl">
        <div class="relative w-full aspect-video bg-black">
          <iframe
            id="ytPlayerFrame"
            class="w-full h-full"
            src=""
            title="Video Player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>

        <!-- Video Metadata Strip -->
        <div class="p-3.5 sm:p-4 bg-[#141414] border-t border-zinc-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span id="playingCategoryBadge" class="px-2.5 py-0.5 rounded-md text-[11px] font-semibold bg-red-600/20 text-red-400 border border-red-500/30">
                Film
              </span>
              <span id="playingDurationBadge" class="text-xs text-zinc-400 font-medium"></span>
            </div>
            <h1 id="playingTitle" class="text-base sm:text-xl font-bold text-white mt-1.5 leading-snug">
              Select a video to watch
            </h1>
          </div>
          <div class="text-xs text-zinc-400">
            Tip: Close (<span class="text-white font-bold">×</span>) the banner below anytime to browse the feed underneath.
          </div>
        </div>
      </div>

      <!-- TIMED ROTATING BANNER AD DIRECTLY BELOW ACTIVE VIDEO -->
      <div id="bannerAdWrapper" class="relative rounded-2xl bg-gradient-to-r from-[#1b1926] via-[#1c1b22] to-[#17212b] border border-amber-500/35 shadow-xl overflow-hidden animate-fade-in">
        <!-- Top bar of banner with rotation timer & Close (×) button -->
        <div class="flex items-center justify-between px-3.5 py-2 bg-black/35 border-b border-white/10">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-400 text-black">
              Sponsored Banner
            </span>
            <span id="bannerRotationStatus" class="text-[11px] sm:text-xs text-zinc-300 font-medium">
              Next ad in <strong id="bannerCountdown" class="text-amber-300">60</strong>s
            </span>
          </div>

          <div class="flex items-center gap-1.5">
            <button
              id="cycleBannerNowBtn"
              type="button"
              class="px-2 py-1 rounded-md bg-white/10 hover:bg-white/20 text-[11px] text-zinc-200 font-medium transition-colors"
              title="Switch banner slot now"
            >
              Next Ad
            </button>
            <button
              id="closeBannerAdBtn"
              type="button"
              class="w-7 h-7 rounded-lg bg-zinc-800/90 hover:bg-red-600 text-zinc-200 hover:text-white flex items-center justify-center font-bold text-base transition-colors"
              title="Close banner ad and show feed below"
              aria-label="Close banner ad"
            >
              &times;
            </button>
          </div>
        </div>

        <!-- Rotating Banner Ad Content -->
        <div id="bannerAdContent" class="p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <div id="bannerTag" class="text-[11px] font-semibold uppercase tracking-wider text-amber-300">
              Featured Series Pass
            </div>
            <h3 id="bannerHeadline" class="text-base sm:text-lg font-bold text-white">
              New Films, Dramas &amp; Daily Stories Added Regularly
            </h3>
            <p id="bannerSubtext" class="text-xs sm:text-sm text-zinc-300 max-w-2xl">
              Save your favorite picks to watch later, or tap &times; above to reveal the full video feed right below the player.
            </p>
          </div>
          <button
            id="bannerActionBtn"
            type="button"
            class="shrink-0 px-4 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-black text-xs sm:text-sm font-bold transition-colors shadow"
          >
            Explore Feed
          </button>
        </div>

        <!-- Thin progress bar showing 60s rotation cycle -->
        <div class="w-full h-1 bg-white/10">
          <div id="bannerProgressBar" class="h-full bg-amber-400 transition-all duration-1000 ease-linear" style="width: 100%;"></div>
        </div>
      </div>
    </section>

    <!-- YOUTUBE-STYLE STREAMING FEED SECTION -->
    <section id="feedSection" class="space-y-4">
      <div class="flex items-center justify-between gap-2">
        <div class="flex items-center gap-2.5">
          <h2 id="feedHeading" class="text-base sm:text-lg font-bold text-white">
            All Videos
          </h2>
          <span id="feedResultCount" class="text-xs text-zinc-400 bg-[#1a1a1a] px-2.5 py-0.5 rounded-full border border-zinc-800">
            0 items
          </span>
        </div>
        <p id="feedSubhint" class="hidden sm:block text-xs text-zinc-400">
          Click any card to play • Save items for quick access
        </p>
      </div>

      <!-- Responsive Multi-Column YouTube Grid -->
      <div id="videoGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
        <!-- Cards rendered dynamically by JavaScript -->
      </div>

      <!-- Empty State -->
      <div id="emptyFeedState" class="hidden rounded-2xl bg-[#161616] border border-zinc-800 p-8 sm:p-12 text-center space-y-3">
        <div class="w-12 h-12 rounded-full bg-zinc-800/90 mx-auto flex items-center justify-center text-zinc-400">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 id="emptyTitle" class="text-base font-bold text-white">No videos found</h3>
        <p id="emptyDesc" class="text-xs sm:text-sm text-zinc-400 max-w-md mx-auto">
          Try clearing your search filter or switching to another category tab.
        </p>
        <button
          id="resetFiltersBtn"
          type="button"
          class="mt-2 px-4 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs sm:text-sm font-semibold transition-colors"
        >
          Show All Videos
        </button>
      </div>
    </section>

    <!-- ADMIN PANEL SECTION (Unlocked when profile name is set to KINGADMIN) -->
    <section id="adminSection" class="hidden animate-fade-in rounded-2xl bg-[#151515] border border-amber-500/40 p-4 sm:p-6 space-y-5 shadow-2xl">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-800 pb-4">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-300 text-[11px] font-bold uppercase tracking-wider mb-1">
            <span>Admin Control</span>
          </div>
          <h2 class="text-lg sm:text-xl font-bold text-white">Kharak Stream Admin Panel</h2>
          <p class="text-xs sm:text-sm text-zinc-400">
            Add YouTube videos by link or ID directly into the live feed. Saved automatically in local storage.
          </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          <button
            id="resetSampleDataBtn"
            type="button"
            class="px-3 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-zinc-200 transition-colors"
          >
            Reset Sample Data
          </button>
          <button
            id="closeAdminPanelBtn"
            type="button"
            class="px-3.5 py-2 rounded-xl bg-amber-400 hover:bg-amber-300 text-black text-xs font-bold transition-colors"
          >
            Done
          </button>
        </div>
      </div>

      <!-- Add Video Form -->
      <form id="addVideoForm" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="videoTitleInput" class="block text-xs font-semibold text-zinc-300 mb-1.5">
            Video Title *
          </label>
          <input
            id="videoTitleInput"
            type="text"
            required
            placeholder="e.g., Midnight Train — Episode 4"
            class="w-full bg-[#0f0f0f] text-sm text-white placeholder-zinc-500 px-3.5 py-2.5 rounded-xl border border-zinc-700 focus:border-amber-400 focus:outline-none"
          />
        </div>

        <div>
          <label for="videoCategoryInput" class="block text-xs font-semibold text-zinc-300 mb-1.5">
            Category *
          </label>
          <select
            id="videoCategoryInput"
            class="w-full bg-[#0f0f0f] text-sm text-white px-3.5 py-2.5 rounded-xl border border-zinc-700 focus:border-amber-400 focus:outline-none"
          >
            <option value="Film">Film (فلم)</option>
            <option value="Drama">Drama (ڈرامہ)</option>
            <option value="Stories">Stories (اسٹوریز)</option>
          </select>
        </div>

        <div>
          <label for="videoUrlOrIdInput" class="block text-xs font-semibold text-zinc-300 mb-1.5">
            YouTube Link or Video ID *
          </label>
          <input
            id="videoUrlOrIdInput"
            type="text"
            required
            placeholder="https://www.youtube.com/watch?v=... or youtu.be/... or 11-char ID"
            class="w-full bg-[#0f0f0f] text-sm text-white placeholder-zinc-500 px-3.5 py-2.5 rounded-xl border border-zinc-700 focus:border-amber-400 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="sm:col-span-2">
            <label for="videoThumbInput" class="block text-xs font-semibold text-zinc-300 mb-1.5">
              Custom Thumbnail URL (Optional)
            </label>
            <input
              id="videoThumbInput"
              type="url"
              placeholder="Auto YouTube thumb if blank"
              class="w-full bg-[#0f0f0f] text-sm text-white placeholder-zinc-500 px-3.5 py-2.5 rounded-xl border border-zinc-700 focus:border-amber-400 focus:outline-none"
            />
          </div>
          <div>
            <label for="videoDurationInput" class="block text-xs font-semibold text-zinc-300 mb-1.5">
              Duration
            </label>
            <input
              id="videoDurationInput"
              type="text"
              placeholder="12:40"
              class="w-full bg-[#0f0f0f] text-sm text-white placeholder-zinc-500 px-3.5 py-2.5 rounded-xl border border-zinc-700 focus:border-amber-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="md:col-span-2 flex items-center justify-between gap-3 pt-1">
          <p id="adminFormError" class="text-xs text-red-400 hidden"></p>
          <button
            type="submit"
            class="ml-auto px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white text-sm font-bold transition-colors shadow-lg shadow-red-900/30"
          >
            + Publish to Feed
          </button>
        </div>
      </form>

      <!-- Manage Existing Videos List -->
      <div class="space-y-2.5 pt-2 border-t border-zinc-800/90">
        <h3 class="text-sm font-bold text-zinc-200">Manage Feed Videos (<span id="adminVideoCount">0</span>)</h3>
        <div id="adminVideoList" class="divide-y divide-zinc-800/80 max-h-72 overflow-y-auto rounded-xl bg-[#0f0f0f] border border-zinc-800">
          <!-- Populated dynamically -->
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-zinc-800/80 bg-[#0c0c0c] py-4 px-3 sm:px-6 text-center text-xs text-zinc-500">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
      <span>FilmDrama Box • فلم • ڈرامہ • اسٹوریز</span>
      <span>Saved items, profile name &amp; feed entries persist in your browser</span>
    </div>
  </footer>

  <!-- PROFILE MODAL -->
  <div
    id="profileModal"
    class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="profileModalTitle"
  >
    <div class="w-full max-w-md rounded-2xl bg-[#181818] border border-zinc-700/90 shadow-2xl overflow-hidden animate-fade-in">
      <div class="flex items-center justify-between px-5 py-4 border-b border-zinc-800">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-red-600/20 border border-red-500/40 flex items-center justify-center text-red-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h2 id="profileModalTitle" class="text-base font-bold text-white">Your Profile</h2>
        </div>
        <button
          id="closeProfileModalBtn"
          type="button"
          class="w-8 h-8 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white flex items-center justify-center text-lg font-bold transition-colors"
          aria-label="Close profile modal"
        >
          &times;
        </button>
      </div>

      <form id="profileForm" class="p-5 space-y-4">
