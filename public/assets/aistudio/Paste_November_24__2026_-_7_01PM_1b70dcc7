                  • Next in <strong class="feed-banner-countdown text-amber-300">${state.bannerSecondsLeft}</strong>s
                </span>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  type="button"
                  class="feed-cycle-banner-btn px-2 py-0.5 rounded bg-white/10 hover:bg-white/20 text-[11px] text-zinc-200 font-medium transition-colors"
                  title="Switch banner ad now"
                >
                  Next Ad
                </button>
                <button
                  type="button"
                  data-close-slot="${slotIndex}"
                  class="feed-close-banner-btn w-6 h-6 rounded-md bg-zinc-800/90 hover:bg-red-600 text-zinc-200 hover:text-white flex items-center justify-center font-bold text-sm transition-colors"
                  title="Close this banner ad"
                  aria-label="Close banner ad"
                >
                  &times;
                </button>
              </div>
            </div>

            <div class="feed-banner-body px-3.5 py-2.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
              <div class="min-w-0">
                <h3 class="feed-banner-headline text-xs sm:text-sm font-bold text-white truncate">
                  ${escapeHtml(currentSlot.headline)}
                </h3>
                <p class="feed-banner-subtext text-[11px] text-zinc-300 truncate">
                  Below "${escapeHtml(anchorVideoTitle)}" • ${escapeHtml(currentSlot.subtext)}
                </p>
