      }

      function renderFeed() {
        syncCategoryTabStyles();

        const filtered = getFilteredVideos();
        const count = filtered.length;
        els.resultCountBadge.textContent = `${count} ${count === 1 ? 'video' : 'videos'}`;

        if (state.activeCategory === 'Saved') {
          els.feedHeading.textContent = 'Saved Videos';
          els.feedSubheading.textContent = 'Your bookmarked films, dramas, and stories stored locally on this device';
        } else if (state.activeCategory === 'All') {
          els.feedHeading.textContent = state.activeVideoId ? 'More in Feed' : 'Trending Feed';
          els.feedSubheading.textContent = 'Film • Drama • Stories — Banner ads sit beneath videos in the feed';
        } else {
          els.feedHeading.textContent = `${state.activeCategory} Feed`;
          els.feedSubheading.textContent = `Showing ${state.activeCategory} titles — banner ads rotate beneath videos as you browse`;
        }

        if (count === 0) {
          els.videoGrid.innerHTML = '';
          els.emptyState.classList.remove('hidden');
          if (state.activeCategory === 'Saved' && !state.searchQuery.trim()) {
            els.emptyStateTitle.textContent = 'No saved videos yet';
            els.emptyStateDesc.textContent = 'Click the Save button on any video card or inside the player to keep it here.';
          } else {
            els.emptyStateTitle.textContent = 'No matching videos found';
            els.emptyStateDesc.textContent = 'Try a different search keyword or switch between All, Film, Drama, Stories, and Saved.';
          }
          return;
        }

        els.emptyState.classList.add('hidden');

        // Group cards into rows of 2 on mobile (2-col grid) so banner ads appear directly beneath video rows
        const chunkSize = 2;
        const chunks = [];
        for (let i = 0; i < filtered.length; i += chunkSize) {
          chunks.push(filtered.slice(i, i + chunkSize));
        }

        let bannerSlotCounter = 0;
        const htmlParts = [];

        chunks.forEach((rowVideos, rowIdx) => {
          htmlParts.push(`
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
              ${rowVideos.map((video) => buildVideoCardHtml(video)).join('')}
            </div>
          `);

          // Place rotating banner slots beneath video rows inside the feed (after 1st row and every 2 rows)
          const shouldInsertBanner =
            state.bannerVisible &&
            rowIdx < chunks.length - 1 &&
            (rowIdx === 0 || rowIdx % 2 === 0);

          if (shouldInsertBanner) {
            const slotIdx = bannerSlotCounter++;
            if (!state.closedBannerSlots[slotIdx]) {
              const anchorTitle = rowVideos[0] ? rowVideos[0].title : 'Feed';
              htmlParts.push(buildInFeedBannerSlotHtml(slotIdx, anchorTitle));
            }
          }
        });

        els.videoGrid.innerHTML = htmlParts.join('');

        // Bind card click & save button click
        els.videoGrid.querySelectorAll('.video-card').forEach((card) => {
          card.addEventListener('click', () => {
            const vidId = card.getAttribute('data-video-id');
            if (vidId) openVideoPlayer(vidId);
          });
        });

        els.videoGrid.querySelectorAll('.save-card-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const vidId = btn.getAttribute('data-save-id');
            if (vidId) toggleSaveVideo(vidId, e);
          });
        });

        // Bind in-feed banner controls
        els.videoGrid.querySelectorAll('.feed-cycle-banner-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            rotateBannerAd(true);
          });
        });

        els.videoGrid.querySelectorAll('.feed-close-banner-btn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const slotKey = btn.getAttribute('data-close-slot');
            if (slotKey !== null) {
              state.closedBannerSlots[slotKey] = true;
            }
            const remainingVisibleSlots = els.videoGrid.querySelectorAll('.in-feed-banner-slot').length - 1;
            if (remainingVisibleSlots <= 0) {
              state.bannerVisible = false;
              syncBannerVisibilityUI();
            }
            renderFeed();
            showToast('Banner ad closed');
          });
        });

        els.videoGrid.querySelectorAll('.feed-banner-cta').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const slot = BANNER_SLOTS[state.bannerIndex % BANNER_SLOTS.length];
            if (slot.action === 'openSaved') {
              state.activeCategory = 'Saved';
            } else if (slot.action === 'openDrama') {
              state.activeCategory = 'Drama';
            } else if (slot.action === 'openStories') {
              state.activeCategory = 'Stories';
            } else {
              state.activeCategory = 'All';
            }
            renderFeed();
            els.feedSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });

        // Keep banner timer active so banners rotate smoothly while the feed is idle
        if (state.bannerVisible && !bannerTimerId) {
          startBannerRotation();
        }
      }

      // =========================================================================
      // VIDEO PLAYER & TIMED ROTATING IN-FEED BANNER ADS (30s & 60s)
      // =========================================================================
      function syncInFeedBannerContent() {
        const slot = BANNER_SLOTS[state.bannerIndex % BANNER_SLOTS.length];
        const totalSec = Math.max(1, state.bannerActiveInterval || getSlotInterval(state.bannerIndex));
        const pct = Math.max(0, Math.min(100, (state.bannerSecondsLeft / totalSec) * 100));

        els.videoGrid.querySelectorAll('.in-feed-banner-slot').forEach((bannerEl) => {
          const tagEl = bannerEl.querySelector('.feed-banner-tag');
          const headlineEl = bannerEl.querySelector('.feed-banner-headline');
          const ctaEl = bannerEl.querySelector('.feed-banner-cta');
          const countdownEl = bannerEl.querySelector('.feed-banner-countdown');
          const progressEl = bannerEl.querySelector('.feed-banner-progress');
          const bodyEl = bannerEl.querySelector('.feed-banner-body');

          if (tagEl) tagEl.textContent = slot.tag;
          if (headlineEl) headlineEl.textContent = slot.headline;
          if (ctaEl) ctaEl.textContent = slot.cta;
          if (countdownEl) countdownEl.textContent = String(state.bannerSecondsLeft);
          if (progressEl) progressEl.style.width = `${pct}%`;

          if (bodyEl) {
            bodyEl.classList.remove('banner-snappy-swap');
            void bodyEl.offsetWidth;
            bodyEl.classList.add('banner-snappy-swap');
          }
        });
      }

      function updateBannerCountdownOnly() {
        const totalSec = Math.max(1, state.bannerActiveInterval || getSlotInterval(state.bannerIndex));
        const pct = Math.max(0, Math.min(100, (state.bannerSecondsLeft / totalSec) * 100));

        els.videoGrid.querySelectorAll('.feed-banner-countdown').forEach((el) => {
          el.textContent = String(state.bannerSecondsLeft);
        });
        els.videoGrid.querySelectorAll('.feed-banner-progress').forEach((el) => {
          el.style.width = `${pct}%`;
        });
      }

      function setBannerSlot(nextIndex) {
        state.bannerIndex = ((nextIndex % BANNER_SLOTS.length) + BANNER_SLOTS.length) % BANNER_SLOTS.length;
        const duration = getSlotInterval(state.bannerIndex);
        state.bannerActiveInterval = duration;
        state.bannerSecondsLeft = duration;
        syncInFeedBannerContent();
      }

      function rotateBannerAd(resetTimer = true) {
        setBannerSlot(state.bannerIndex + 1);
        if (bannerSwapTimeoutId) {
          clearTimeout(bannerSwapTimeoutId);
        }
        bannerSwapTimeoutId = setTimeout(() => {
          els.videoGrid.querySelectorAll('.feed-banner-body').forEach((bodyEl) => {
            bodyEl.classList.remove('banner-snappy-swap');
          });
        }, 200);

        if (resetTimer && state.bannerVisible) {
          startBannerRotation();
        }
      }

      function startBannerRotation() {
        stopBannerRotation();
        if (!state.bannerVisible) return;

        updateBannerCountdownOnly();

        // Snappy 500ms tick paired with smooth 30s/60s slot intervals
        let subTicks = 0;
        bannerTimerId = setInterval(() => {
          if (!state.bannerVisible) {
            stopBannerRotation();
            return;
          }
          subTicks += 1;
          if (subTicks >= 2) {
            subTicks = 0;
            state.bannerSecondsLeft -= 1;
            if (state.bannerSecondsLeft <= 0) {
              setBannerSlot(state.bannerIndex + 1);
            } else {
              updateBannerCountdownOnly();
            }
          }
        }, 500);
      }

      function stopBannerRotation() {
        if (bannerTimerId) {
          clearInterval(bannerTimerId);
          bannerTimerId = null;
        }
      }

      function syncBannerVisibilityUI() {
        if (state.bannerVisible) {
          els.reopenBannerBtn.classList.add('hidden');
          startBannerRotation();
        } else {
          els.reopenBannerBtn.classList.remove('hidden');
          stopBannerRotation();
        }
