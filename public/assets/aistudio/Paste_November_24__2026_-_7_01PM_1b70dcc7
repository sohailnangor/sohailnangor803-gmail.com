      function buildInFeedBannerSlotHtml(slotIndex, anchorVideoTitle) {
        const currentSlot = BANNER_SLOTS[state.bannerIndex % BANNER_SLOTS.length];
        const totalSec = Math.max(1, state.bannerActiveInterval || getSlotInterval(state.bannerIndex));
        const pct = Math.max(0, Math.min(100, (state.bannerSecondsLeft / totalSec) * 100));

        return `
          <div
            data-feed-banner-slot="${slotIndex}"
            class="in-feed-banner-slot rounded-2xl bg-gradient-to-r from-[#1b1926] via-[#1c1b22] to-[#17212b] border border-amber-500/35 shadow-lg overflow-hidden"
          >
